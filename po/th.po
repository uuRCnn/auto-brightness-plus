msgstr "แดง"

#: src/lib/ui.js:1442 src/lib/ui.js:1591 src/lib/ui.js:1860
msgid "Back to the default"
msgstr "กลับเป็นค่าเริ่มต้น"

#: src/lib/ui.js:1547
msgid "While the screen is off"
msgstr "ขณะที่จอปิดอยู่"

#: src/lib/ui.js:1587
msgid "Dark while off"
msgstr "ความมืดขณะปิด"

#: src/lib/ui.js:1588
msgid ""
"While the screen is off, the monitor stays at its lowest light and this much "
"black is added on top. 25 % = a little darker, 100 % = fully black."
msgstr ""
"ขณะปิดหน้าจอ จอจะอยู่ที่แสงต่ำสุดและเพิ่มสีดำทับเท่านี้ 25 % = มืดลงเล็กน้อย, 100 % = ดำสนิท"

#: src/lib/ui.js:1608
#, javascript-format
msgid "Keep lit for %s"
msgstr "เปิดค้างไว้ %s"

#: src/lib/ui.js:1609
#, javascript-format
msgid ""
"On: after the mouse leaves, the screen stays lit for %s, then goes dark. "
"Off: it goes dark as soon as the mouse leaves."
msgstr "เปิด: หลังเมาส์ออกไป หน้าจอจะสว่างต่ออีก %s แล้วจึงมืด ปิด: มืดทันทีที่เมาส์ออกไป"

#: src/lib/ui.js:1693
#, javascript-format
msgid "Brightness %s"
msgstr "ความสว่าง %s"

#: src/lib/ui.js:1695
msgid "Turned off"
msgstr "ปิดแล้ว"

#: src/lib/ui.js:1715
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "ตก %s %s %d นาที"

#: src/lib/ui.js:1718
msgid "Fixed time"
msgstr "เวลาที่กำหนด"

#: src/lib/ui.js:1721
#, javascript-format
