#: src/prefs.js:75
msgid "General"
msgstr "ทั่วไป"

#: src/prefs.js:78
msgid "Sliders"
msgstr "แถบเลื่อน"

#: src/prefs.js:79
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr "ทุกจอมีแถบเลื่อนของตัวเองในการตั้งค่าด่วน ข้างแถบเสียง"

#: src/prefs.js:81
msgid "Left of the slider"
msgstr "ด้านซ้ายของแถบเลื่อน"

#: src/prefs.js:82
msgid "Brightness icon"
msgstr "ไอคอนความสว่าง"

#: src/prefs.js:83
msgid "Monitor number (1, 2, 3…)"
msgstr "หมายเลขจอ (1, 2, 3…)"

#: src/prefs.js:84
msgid "Short name (LG, VS…)"
msgstr "ชื่อย่อ (LG, VS…)"

#: src/prefs.js:86
msgid "Show the monitor name on hover"
msgstr "แสดงชื่อจอเมื่อชี้เมาส์"

#: src/prefs.js:87
msgid "Replace GNOME’s own brightness slider"
msgstr "แทนที่แถบความสว่างของ GNOME"

#: src/prefs.js:88
msgid "The laptop screen then gets a row like the other monitors"
msgstr "จอโน้ตบุ๊กจะมีแถวของตัวเองเหมือนจออื่น"

#: src/prefs.js:91
msgid "Night Light"
msgstr "แสงกลางคืน"

#: src/prefs.js:92
msgid "Add a menu to the Night Light button"
msgstr "เพิ่มเมนูให้ปุ่มแสงกลางคืน"

#: src/prefs.js:93
msgid "Temperature, red screen and its strength"
msgstr "อุณหภูมิสี จอแดง และความแรง"

#: src/prefs.js:99
msgid "Evening"
msgstr "ตอนเย็น"

#: src/prefs.js:102 src/lib/ui.js:257
msgid "Evening dimming"
msgstr "หรี่แสงตอนเย็น"

#: src/prefs.js:103
msgid ""
"Turn it on per monitor with the moon button next to its slider. Brightness "
"goes down slowly in the evening and comes back in the morning."
msgstr ""
"เปิดแยกแต่ละจอด้วยปุ่มพระจันทร์ข้างแถบเลื่อน ความสว่างจะค่อย ๆ ลดลงตอนเย็นและกลับมาตอนเช้า"

#: src/prefs.js:105 src/lib/ui.js:264
msgid "Start"
msgstr "เริ่ม"

#: src/prefs.js:106
msgid "At sunset"
msgstr "ตอนพระอาทิตย์ตก"

#: src/prefs.js:107
msgid "At a fixed time"
msgstr "ตามเวลาที่กำหนด"

#: src/prefs.js:109
msgid "Transition"
msgstr "ช่วงเปลี่ยน"

#: src/prefs.js:109
msgid "Minutes, for both evening and morning"
msgstr "นาที ทั้งตอนเย็นและตอนเช้า"

#: src/prefs.js:110 src/prefs.js:111
msgid "Morning"
msgstr "ตอนเช้า"

#: src/prefs.js:110
msgid "Minutes after sunrise"
msgstr "นาทีหลังพระอาทิตย์ขึ้น"

#: src/prefs.js:111
msgid "Brightness comes back at"
msgstr "ความสว่างกลับมาเวลา"

#: src/prefs.js:117
msgid "For new monitors"
msgstr "สำหรับจอใหม่"

#: src/prefs.js:118
msgid "Each monitor can change these in its own menu."
msgstr "แต่ละจอเปลี่ยนค่าเหล่านี้ได้ในเมนูของตัวเอง"

#: src/prefs.js:120
msgid "Minutes after sunset"
msgstr "นาทีหลังพระอาทิตย์ตก"

#: src/prefs.js:121
msgid "Start time"
msgstr "เวลาเริ่ม"

#: src/prefs.js:125 src/lib/ui.js:269
msgid "Night brightness"
msgstr "ความสว่างกลางคืน"

#: src/prefs.js:125
msgid "Percent"
msgstr "เปอร์เซ็นต์"

#: src/prefs.js:134 src/prefs.js:137
msgid "Location"
msgstr "ตำแหน่ง"

#: src/prefs.js:135
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"ใช้เพื่อคำนวณเวลาพระอาทิตย์ตกและขึ้นเท่านั้น อัตโนมัติใช้ตำแหน่งที่ GNOME เก็บไว้สำหรับแสงกลางคืน "
"หรือเขตเวลา ไม่มีการส่งข้อมูลใด ๆ"

#: src/prefs.js:138
msgid "Automatic"
msgstr "อัตโนมัติ"

#: src/prefs.js:139
msgid "Manual"
msgstr "กำหนดเอง"

#: src/prefs.js:141
msgid "Latitude"
msgstr "ละติจูด"

#: src/prefs.js:142
msgid "Longitude"
msgstr "ลองจิจูด"

#: src/prefs.js:145
msgid "Today"
msgstr "วันนี้"

#: src/prefs.js:162
msgid "manual"
msgstr "กำหนดเอง"

#: src/prefs.js:163
msgid "GNOME location"
msgstr "ตำแหน่ง GNOME"

#: src/prefs.js:164
#, javascript-format
msgid "time zone %s"
msgstr "เขตเวลา %s"

#: src/prefs.js:165
msgid "UTC offset"
msgstr "ส่วนต่าง UTC"

#: src/prefs.js:168
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "ตก %s · ขึ้น %s · จาก %s"

#: src/prefs.js:176
msgid "Screen off"
msgstr "ปิดจอ"

#: src/prefs.js:179 src/lib/ui.js:293
msgid "Turn off screen"
msgstr "ปิดจอ"

#: src/prefs.js:180
msgid "“Turn off screen” and “Turn off others” in each monitor’s menu."
msgstr "“ปิดจอ” และ “ปิดจออื่น” ในเมนูของแต่ละจอ"

#: src/prefs.js:182
msgid "Turned off screen"
msgstr "จอที่ปิด"

#: src/prefs.js:183
msgid "Fully black"
msgstr "ดำสนิท"

#: src/prefs.js:184
msgid "Lowest light"
msgstr "แสงต่ำสุด"

#: src/prefs.js:186
msgid "Light left"
msgstr "แสงที่เหลือ"

#: src/prefs.js:186
msgid "Percent, for “Lowest light”"
msgstr "เปอร์เซ็นต์ สำหรับ “แสงต่ำสุด”"

#: src/prefs.js:188
msgid "Turn back on when the mouse comes"
msgstr "เปิดอีกครั้งเมื่อเมาส์มา"

#: src/prefs.js:189
msgid "Moving the mouse onto a turned off screen brings its light back"
msgstr "เลื่อนเมาส์ไปยังจอที่ปิดจะทำให้แสงกลับมา"

#: src/prefs.js:196 src/lib/ui.js:429 src/lib/ui.js:490
msgid "Red screen"
msgstr "จอแดง"

#: src/prefs.js:197
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr "เปิดได้ในเมนูแสงกลางคืน ตัดแสงสีน้ำเงินและสีเขียวทั้งหมด ช่วยให้นอนหลับ"

#: src/prefs.js:199
msgid "Only while Night Light is active"
msgstr "เฉพาะเมื่อแสงกลางคืนทำงาน"

#: src/prefs.js:200
msgid "Starts and stops together with Night Light"
msgstr "เริ่มและหยุดพร้อมแสงกลางคืน"

#: src/prefs.js:201 src/lib/ui.js:439
msgid "Strength"
msgstr "ความแรง"

#: src/prefs.js:215
msgid "Advanced"
msgstr "ขั้นสูง"

#: src/prefs.js:219
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr "จอภายนอกควบคุมผ่าน DDC/CI ผู้ใช้ต้องเข้าถึง /dev/i2c-* ได้ (ปกติคือกลุ่ม “i2c”)"

#: src/prefs.js:223
msgid "ddcutil found"
msgstr "พบ ddcutil"

#: src/prefs.js:223
msgid "ddcutil not found"
msgstr "ไม่พบ ddcutil"

#: src/prefs.js:224
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "ติดตั้ง ddcutil จากดิสโทรของคุณ แล้วกดสแกนอีกครั้ง"

#: src/prefs.js:226
msgid "Scan again"
msgstr "สแกนอีกครั้ง"

#: src/prefs.js:231
msgid "ddcutil program"
msgstr "โปรแกรม ddcutil"

#: src/prefs.js:234
msgid "Extra arguments"
msgstr "อาร์กิวเมนต์เพิ่มเติม"

#: src/prefs.js:237
msgid "Pause between writes"
msgstr "พักระหว่างการเขียน"

#: src/prefs.js:238
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "มิลลิวินาที เพิ่มขึ้นหากจอพลาดการเปลี่ยนแปลง"

#: src/prefs.js:242
msgid "Debug messages"
msgstr "ข้อความดีบัก"

#: src/prefs.js:242
msgid "Written to the system journal"
msgstr "เขียนลงบันทึกระบบ"

#: src/lib/displays.js:37
msgid "Monitor"
msgstr "จอ"

#: src/lib/displays.js:287
msgid "Built-in Display"
msgstr "จอในตัว"

#: src/lib/displays.js:288
msgid "Built-in"
msgstr "ในตัว"

#: src/lib/displays.js:290
#, javascript-format
msgid "Monitor %d"
msgstr "จอ %d"

#: src/lib/ui.js:119
msgid "Earlier"
msgstr "เร็วขึ้น"

#: src/lib/ui.js:122
msgid "Later"
msgstr "ช้าลง"

#: src/lib/ui.js:165
msgid "Evening dimming and more"
msgstr "หรี่แสงตอนเย็นและอื่น ๆ"

#: src/lib/ui.js:282
msgid "Extra dimming"
msgstr "หรี่แสงเพิ่ม"

#: src/lib/ui.js:294
msgid "Turn off others"
msgstr "ปิดจออื่น"

#: src/lib/ui.js:318
msgid "Off"
msgstr "ปิด"

#: src/lib/ui.js:335
msgid "Turned off"
msgstr "ปิดแล้ว"

#: src/lib/ui.js:335
#, javascript-format
msgid "Brightness %s"
msgstr "ความสว่าง %s"

#: src/lib/ui.js:344
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "ตก %s %s %d นาที"

#: src/lib/ui.js:347
msgid "Fixed time"
msgstr "เวลาที่กำหนด"

#: src/lib/ui.js:421
msgid "Temperature"
msgstr "อุณหภูมิสี"

#: src/lib/ui.js:498
msgid "Sunset to sunrise"
msgstr "ตั้งแต่ตกถึงขึ้น"

#: src/lib/ui.js:514
msgid "Turns on together with Night Light"
msgstr "เปิดพร้อมแสงกลางคืน"

#: src/lib/ui.js:516
msgid "Starts when Night Light starts"
msgstr "เริ่มเมื่อแสงกลางคืนเริ่ม"
