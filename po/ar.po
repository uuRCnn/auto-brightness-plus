#: src/lib/ui.js:122
msgid "Later"
msgstr "لاحقًا"

#: src/lib/ui.js:165
msgid "Evening dimming and more"
msgstr "التعتيم المسائي والمزيد"

#: src/lib/ui.js:282
msgid "Extra dimming"
msgstr "تعتيم إضافي"

#: src/lib/ui.js:294
msgid "Turn off others"
msgstr "أطفئ الأخرى"

#: src/lib/ui.js:318
msgid "Off"
msgstr "معطل"

#: src/lib/ui.js:335
msgid "Turned off"
msgstr "مطفأة"

#: src/lib/ui.js:335
#, javascript-format
msgid "Brightness %s"
msgstr "السطوع %s"

#: src/lib/ui.js:344
#, javascript-format
msgid "Sunset %s %s %d min"
