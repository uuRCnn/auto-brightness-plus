#: src/prefs.js:75
msgid "General"
msgstr "عام"

#: src/prefs.js:78
msgid "Sliders"
msgstr "المنزلقات"

#: src/prefs.js:79
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr "تحصل كل شاشة على منزلق خاص بها في الإعدادات السريعة بجوار منزلق الصوت."

#: src/prefs.js:81
msgid "Left of the slider"
msgstr "يسار المنزلق"

#: src/prefs.js:82
msgid "Brightness icon"
msgstr "أيقونة السطوع"

#: src/prefs.js:83
msgid "Monitor number (1, 2, 3…)"
msgstr "رقم الشاشة (1، 2، 3…)"

#: src/prefs.js:84
msgid "Short name (LG, VS…)"
msgstr "اسم مختصر (LG، VS…)"

#: src/prefs.js:86
msgid "Show the monitor name on hover"
msgstr "إظهار اسم الشاشة عند المرور"

#: src/prefs.js:87
msgid "Replace GNOME’s own brightness slider"
msgstr "استبدال منزلق سطوع جنوم"

#: src/prefs.js:88
msgid "The laptop screen then gets a row like the other monitors"
msgstr "تحصل شاشة الحاسوب المحمول على صف مثل باقي الشاشات"

#: src/prefs.js:91
msgid "Night Light"
msgstr "الضوء الليلي"

#: src/prefs.js:92
msgid "Add a menu to the Night Light button"
msgstr "إضافة قائمة إلى زر الضوء الليلي"

#: src/prefs.js:93
msgid "Temperature, red screen and its strength"
msgstr "درجة الحرارة والشاشة الحمراء وقوتها"

#: src/prefs.js:99
msgid "Evening"
msgstr "المساء"

#: src/prefs.js:102 src/lib/ui.js:257
msgid "Evening dimming"
msgstr "التعتيم المسائي"

#: src/prefs.js:103
msgid ""
"Turn it on per monitor with the moon button next to its slider. Brightness "
"goes down slowly in the evening and comes back in the morning."
msgstr ""
"فعّله لكل شاشة بزر القمر بجوار منزلقها. ينخفض السطوع ببطء مساءً ويعود صباحًا."

#: src/prefs.js:105 src/lib/ui.js:264
msgid "Start"
msgstr "البدء"

#: src/prefs.js:106
msgid "At sunset"
msgstr "عند الغروب"

#: src/prefs.js:107
msgid "At a fixed time"
msgstr "في وقت محدد"

#: src/prefs.js:109
msgid "Transition"
msgstr "الانتقال"

#: src/prefs.js:109
msgid "Minutes, for both evening and morning"
msgstr "دقائق، للمساء والصباح"

#: src/prefs.js:110 src/prefs.js:111
msgid "Morning"
msgstr "الصباح"

#: src/prefs.js:110
msgid "Minutes after sunrise"
msgstr "دقائق بعد الشروق"

#: src/prefs.js:111
msgid "Brightness comes back at"
msgstr "يعود السطوع عند"

#: src/prefs.js:117
msgid "For new monitors"
msgstr "للشاشات الجديدة"

#: src/prefs.js:118
msgid "Each monitor can change these in its own menu."
msgstr "يمكن لكل شاشة تغيير ذلك من قائمتها."

#: src/prefs.js:120
msgid "Minutes after sunset"
msgstr "دقائق بعد الغروب"

#: src/prefs.js:121
msgid "Start time"
msgstr "وقت البدء"

#: src/prefs.js:125 src/lib/ui.js:269
msgid "Night brightness"
msgstr "السطوع الليلي"

#: src/prefs.js:125
msgid "Percent"
msgstr "نسبة مئوية"

#: src/prefs.js:134 src/prefs.js:137
msgid "Location"
msgstr "الموقع"

#: src/prefs.js:135
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"يُستخدم فقط لحساب الغروب والشروق. التلقائي يستخدم الموقع الذي يحفظه جنوم "
"للضوء الليلي، وإلا فالمنطقة الزمنية. لا يُرسل أي شيء."

#: src/prefs.js:138
msgid "Automatic"
msgstr "تلقائي"

#: src/prefs.js:139
msgid "Manual"
msgstr "يدوي"

#: src/prefs.js:141
msgid "Latitude"
msgstr "خط العرض"

#: src/prefs.js:142
msgid "Longitude"
msgstr "خط الطول"

#: src/prefs.js:145
msgid "Today"
msgstr "اليوم"

#: src/prefs.js:162
msgid "manual"
msgstr "يدوي"

#: src/prefs.js:163
msgid "GNOME location"
msgstr "موقع جنوم"

#: src/prefs.js:164
#, javascript-format
msgid "time zone %s"
msgstr "المنطقة الزمنية %s"

#: src/prefs.js:165
msgid "UTC offset"
msgstr "فرق UTC"

#: src/prefs.js:168
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "الغروب %s · الشروق %s · من %s"

#: src/prefs.js:176
msgid "Screen off"
msgstr "إطفاء الشاشة"

#: src/prefs.js:179 src/lib/ui.js:293
msgid "Turn off screen"
msgstr "أطفئ الشاشة"

#: src/prefs.js:180
msgid "“Turn off screen” and “Turn off others” in each monitor’s menu."
msgstr "«أطفئ الشاشة» و«أطفئ الأخرى» في قائمة كل شاشة."

#: src/prefs.js:182
msgid "Turned off screen"
msgstr "الشاشة المطفأة"

#: src/prefs.js:183
msgid "Fully black"
msgstr "سوداء تمامًا"

#: src/prefs.js:184
msgid "Lowest light"
msgstr "أقل ضوء"

#: src/prefs.js:186
msgid "Light left"
msgstr "الضوء المتبقي"

#: src/prefs.js:186
msgid "Percent, for “Lowest light”"
msgstr "نسبة مئوية، لـ«أقل ضوء»"

#: src/prefs.js:188
msgid "Turn back on when the mouse comes"
msgstr "أعد التشغيل عند قدوم الفأرة"

#: src/prefs.js:189
msgid "Moving the mouse onto a turned off screen brings its light back"
msgstr "تحريك الفأرة إلى شاشة مطفأة يعيد ضوءها"

#: src/prefs.js:196 src/lib/ui.js:429 src/lib/ui.js:490
msgid "Red screen"
msgstr "الشاشة الحمراء"

#: src/prefs.js:197
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr ""
"فعّلها من قائمة الضوء الليلي. تزيل كل الضوء الأزرق والأخضر وتساعدك على النوم."

#: src/prefs.js:199
msgid "Only while Night Light is active"
msgstr "فقط أثناء تفعيل الضوء الليلي"

#: src/prefs.js:200
msgid "Starts and stops together with Night Light"
msgstr "تبدأ وتنتهي مع الضوء الليلي"

#: src/prefs.js:201 src/lib/ui.js:439
msgid "Strength"
msgstr "القوة"

#: src/prefs.js:215
msgid "Advanced"
msgstr "متقدم"

#: src/prefs.js:219
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"تُتحكم الشاشات الخارجية عبر DDC/CI. يحتاج مستخدمك إلى صلاحية /dev/i2c-* (عادة "
"مجموعة «i2c»)."

#: src/prefs.js:223
msgid "ddcutil found"
msgstr "تم العثور على ddcutil"

#: src/prefs.js:223
msgid "ddcutil not found"
msgstr "لم يُعثر على ddcutil"

#: src/prefs.js:224
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "ثبّت ddcutil من توزيعتك ثم اضغط «افحص مجددًا»"

#: src/prefs.js:226
msgid "Scan again"
msgstr "افحص مجددًا"

#: src/prefs.js:231
msgid "ddcutil program"
msgstr "برنامج ddcutil"

#: src/prefs.js:234
msgid "Extra arguments"
msgstr "وسائط إضافية"

#: src/prefs.js:237
msgid "Pause between writes"
msgstr "مهلة بين الكتابات"

#: src/prefs.js:238
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "بالمللي ثانية. زدها إذا فوّتت شاشة تغييرات"

#: src/prefs.js:242
msgid "Debug messages"
msgstr "رسائل التنقيح"

#: src/prefs.js:242
msgid "Written to the system journal"
msgstr "تُكتب في سجل النظام"

