#: src/lib/ui.js:421
msgid "Temperature"
msgstr "درجة الحرارة"

#: src/lib/ui.js:498
msgid "Sunset to sunrise"
msgstr "من الغروب إلى الشروق"

#: src/lib/ui.js:514
msgid "Turns on together with Night Light"
msgstr "تعمل مع الضوء الليلي"

#: src/lib/ui.js:516
