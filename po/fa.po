#: src/prefs.js:75
msgid "General"
msgstr "عمومی"

#: src/prefs.js:78
msgid "Sliders"
msgstr "لغزنده‌ها"

#: src/prefs.js:79
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr "هر نمایشگر در تنظیمات سریع، کنار لغزندهٔ صدا، لغزندهٔ خودش را دارد."

#: src/prefs.js:81
msgid "Left of the slider"
msgstr "سمت چپ لغزنده"

#: src/prefs.js:82
msgid "Brightness icon"
msgstr "نماد روشنایی"

#: src/prefs.js:83
msgid "Monitor number (1, 2, 3…)"
msgstr "شمارهٔ نمایشگر (۱، ۲، ۳…)"

#: src/prefs.js:84
msgid "Short name (LG, VS…)"
msgstr "نام کوتاه (LG، VS…)"

#: src/prefs.js:86
msgid "Show the monitor name on hover"
msgstr "نمایش نام نمایشگر هنگام نگه‌داشتن نشانگر"

#: src/prefs.js:87
msgid "Replace GNOME’s own brightness slider"
msgstr "جایگزینی لغزندهٔ روشنایی گنوم"

#: src/prefs.js:88
msgid "The laptop screen then gets a row like the other monitors"
msgstr "صفحهٔ لپ‌تاپ هم مانند دیگر نمایشگرها یک ردیف می‌گیرد"

#: src/prefs.js:91
msgid "Night Light"
msgstr "نور شب"

#: src/prefs.js:92
msgid "Add a menu to the Night Light button"
msgstr "افزودن منو به دکمهٔ نور شب"

#: src/prefs.js:93
msgid "Temperature, red screen and its strength"
msgstr "دمای رنگ، صفحهٔ قرمز و شدت آن"

#: src/prefs.js:99
msgid "Evening"
msgstr "عصر"

#: src/prefs.js:102 src/lib/ui.js:257
msgid "Evening dimming"
msgstr "کم‌نور کردن عصرگاهی"

#: src/prefs.js:103
msgid ""
"Turn it on per monitor with the moon button next to its slider. Brightness "
"goes down slowly in the evening and comes back in the morning."
msgstr ""
"برای هر نمایشگر با دکمهٔ ماه کنار لغزنده‌اش روشن کنید. روشنایی عصر آرام کم "
"می‌شود و صبح برمی‌گردد."

#: src/prefs.js:105 src/lib/ui.js:264
msgid "Start"
msgstr "شروع"

#: src/prefs.js:106
msgid "At sunset"
msgstr "هنگام غروب"

#: src/prefs.js:107
msgid "At a fixed time"
msgstr "در زمانی ثابت"

#: src/prefs.js:109
msgid "Transition"
msgstr "گذار"

#: src/prefs.js:109
msgid "Minutes, for both evening and morning"
msgstr "دقیقه، برای عصر و صبح"

#: src/prefs.js:110 src/prefs.js:111
msgid "Morning"
msgstr "صبح"

#: src/prefs.js:110
msgid "Minutes after sunrise"
msgstr "دقیقه پس از طلوع"

#: src/prefs.js:111
msgid "Brightness comes back at"
msgstr "روشنایی برمی‌گردد در"

#: src/prefs.js:117
msgid "For new monitors"
msgstr "برای نمایشگرهای جدید"

#: src/prefs.js:118
msgid "Each monitor can change these in its own menu."
msgstr "هر نمایشگر می‌تواند این‌ها را در منوی خودش تغییر دهد."

#: src/prefs.js:120
msgid "Minutes after sunset"
msgstr "دقیقه پس از غروب"

#: src/prefs.js:121
msgid "Start time"
msgstr "زمان شروع"

#: src/prefs.js:125 src/lib/ui.js:269
msgid "Night brightness"
msgstr "روشنایی شب"

#: src/prefs.js:125
msgid "Percent"
msgstr "درصد"

#: src/prefs.js:134 src/prefs.js:137
msgid "Location"
msgstr "مکان"

#: src/prefs.js:135
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"فقط برای محاسبهٔ غروب و طلوع استفاده می‌شود. خودکار از مکانی که گنوم برای نور "
"شب نگه می‌دارد استفاده می‌کند، وگرنه از منطقهٔ زمانی. چیزی ارسال نمی‌شود."

#: src/prefs.js:138
msgid "Automatic"
msgstr "خودکار"

#: src/prefs.js:139
msgid "Manual"
msgstr "دستی"

#: src/prefs.js:141
msgid "Latitude"
msgstr "عرض جغرافیایی"

#: src/prefs.js:142
msgid "Longitude"
msgstr "طول جغرافیایی"

#: src/prefs.js:145
msgid "Today"
msgstr "امروز"

#: src/prefs.js:162
msgid "manual"
msgstr "دستی"

#: src/prefs.js:163
msgid "GNOME location"
msgstr "مکان گنوم"

#: src/prefs.js:164
#, javascript-format
msgid "time zone %s"
msgstr "منطقهٔ زمانی %s"

#: src/prefs.js:165
msgid "UTC offset"
msgstr "اختلاف UTC"

#: src/prefs.js:168
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "غروب %s · طلوع %s · از %s"

#: src/prefs.js:176
msgid "Screen off"
msgstr "خاموشی"

#: src/prefs.js:179 src/lib/ui.js:293
msgid "Turn off screen"
msgstr "خاموش کردن صفحه"

#: src/prefs.js:180
msgid "“Turn off screen” and “Turn off others” in each monitor’s menu."
msgstr "«خاموش کردن صفحه» و «خاموش کردن بقیه» در منوی هر نمایشگر."

#: src/prefs.js:182
msgid "Turned off screen"
msgstr "صفحهٔ خاموش"

#: src/prefs.js:183
msgid "Fully black"
msgstr "کاملاً سیاه"

#: src/prefs.js:184
msgid "Lowest light"
msgstr "کمترین نور"

#: src/prefs.js:186
msgid "Light left"
msgstr "نور باقی‌مانده"

#: src/prefs.js:186
msgid "Percent, for “Lowest light”"
msgstr "درصد، برای «کمترین نور»"

#: src/prefs.js:188
msgid "Turn back on when the mouse comes"
msgstr "روشن شدن با آمدن موشی"

#: src/prefs.js:189
msgid "Moving the mouse onto a turned off screen brings its light back"
msgstr "بردن موشی روی صفحهٔ خاموش نورش را برمی‌گرداند"

#: src/prefs.js:196 src/lib/ui.js:429 src/lib/ui.js:490
msgid "Red screen"
msgstr "صفحهٔ قرمز"

#: src/prefs.js:197
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr ""
"از منوی نور شب روشن کنید. همهٔ نور آبی و سبز را حذف می‌کند و به خواب کمک می‌کند."

#: src/prefs.js:199
msgid "Only while Night Light is active"
msgstr "فقط وقتی نور شب فعال است"

#: src/prefs.js:200
msgid "Starts and stops together with Night Light"
msgstr "همراه با نور شب شروع و تمام می‌شود"

#: src/prefs.js:201 src/lib/ui.js:439
msgid "Strength"
msgstr "شدت"

#: src/prefs.js:215
msgid "Advanced"
msgstr "پیشرفته"

#: src/prefs.js:219
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"نمایشگرهای خارجی با DDC/CI کنترل می‌شوند. کاربر به /dev/i2c-* دسترسی لازم "
"دارد (معمولاً گروه «i2c»)."

#: src/prefs.js:223
msgid "ddcutil found"
msgstr "ddcutil پیدا شد"

#: src/prefs.js:223
msgid "ddcutil not found"
msgstr "ddcutil پیدا نشد"

#: src/prefs.js:224
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "ddcutil را از توزیع خود نصب کنید و سپس «جست‌وجوی دوباره» را بزنید"

#: src/prefs.js:226
msgid "Scan again"
msgstr "جست‌وجوی دوباره"

#: src/prefs.js:231
msgid "ddcutil program"
msgstr "برنامهٔ ddcutil"

#: src/prefs.js:234
msgid "Extra arguments"
msgstr "آرگومان‌های اضافه"

#: src/prefs.js:237
msgid "Pause between writes"
msgstr "مکث بین نوشتن‌ها"

#: src/prefs.js:238
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "میلی‌ثانیه. اگر نمایشگری تغییرات را از دست می‌دهد افزایش دهید"

#: src/prefs.js:242
msgid "Debug messages"
msgstr "پیام‌های اشکال‌زدایی"

#: src/prefs.js:242
msgid "Written to the system journal"
msgstr "در ژورنال سیستم نوشته می‌شوند"

#: src/lib/displays.js:37
msgid "Monitor"
msgstr "نمایشگر"

#: src/lib/displays.js:287
msgid "Built-in Display"
msgstr "نمایشگر داخلی"

#: src/lib/displays.js:288
msgid "Built-in"
msgstr "داخلی"

#: src/lib/displays.js:290
#, javascript-format
msgid "Monitor %d"
msgstr "نمایشگر %d"

#: src/lib/ui.js:119
msgid "Earlier"
msgstr "زودتر"

#: src/lib/ui.js:122
msgid "Later"
msgstr "دیرتر"

#: src/lib/ui.js:165
msgid "Evening dimming and more"
msgstr "کم‌نور کردن عصرگاهی و بیشتر"

#: src/lib/ui.js:282
msgid "Extra dimming"
msgstr "کم‌نوری اضافه"

#: src/lib/ui.js:294
msgid "Turn off others"
msgstr "خاموش کردن بقیه"

#: src/lib/ui.js:318
msgid "Off"
msgstr "خاموش"

#: src/lib/ui.js:335
msgid "Turned off"
msgstr "خاموش شد"

#: src/lib/ui.js:335
#, javascript-format
msgid "Brightness %s"
msgstr "روشنایی %s"

#: src/lib/ui.js:344
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "غروب %s %s %d دقیقه"

#: src/lib/ui.js:347
msgid "Fixed time"
msgstr "زمان ثابت"

#: src/lib/ui.js:421
msgid "Temperature"
msgstr "دمای رنگ"

#: src/lib/ui.js:498
msgid "Sunset to sunrise"
msgstr "از غروب تا طلوع"

#: src/lib/ui.js:514
msgid "Turns on together with Night Light"
msgstr "همراه با نور شب روشن می‌شود"

#: src/lib/ui.js:516
msgid "Starts when Night Light starts"
msgstr "با شروع نور شب شروع می‌شود"
