#: src/prefs.js:75
msgid "General"
msgstr "일반"

#: src/prefs.js:78
msgid "Sliders"
msgstr "슬라이더"

#: src/prefs.js:79
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr ""
"모든 모니터가 빠른 설정의 음량 슬라이더 옆에 자신의 슬라이더를 갖습니다."

#: src/prefs.js:81
msgid "Left of the slider"
msgstr "슬라이더 왼쪽"

#: src/prefs.js:82
msgid "Brightness icon"
msgstr "밝기 아이콘"

#: src/prefs.js:83
msgid "Monitor number (1, 2, 3…)"
msgstr "모니터 번호 (1, 2, 3…)"

#: src/prefs.js:84
msgid "Short name (LG, VS…)"
msgstr "짧은 이름 (LG, VS…)"

#: src/prefs.js:86
msgid "Show the monitor name on hover"
msgstr "마우스를 올리면 모니터 이름 표시"

#: src/prefs.js:87
msgid "Replace GNOME’s own brightness slider"
msgstr "GNOME 기본 밝기 슬라이더 대체"

#: src/prefs.js:88
msgid "The laptop screen then gets a row like the other monitors"
msgstr "노트북 화면도 다른 모니터처럼 한 줄을 갖습니다"

#: src/prefs.js:91
msgid "Night Light"
msgstr "야간 모드"

#: src/prefs.js:92
msgid "Add a menu to the Night Light button"
msgstr "야간 모드 버튼에 메뉴 추가"

#: src/prefs.js:93
msgid "Temperature, red screen and its strength"
msgstr "색온도, 빨간 화면과 그 강도"

#: src/prefs.js:99
msgid "Evening"
msgstr "저녁"

#: src/prefs.js:102 src/lib/ui.js:257
msgid "Evening dimming"
msgstr "저녁 어둡게 하기"

#: src/prefs.js:103
msgid ""
"Turn it on per monitor with the moon button next to its slider. Brightness "
"goes down slowly in the evening and comes back in the morning."
msgstr ""
"슬라이더 옆 달 버튼으로 모니터마다 켭니다. 저녁에 밝기가 천천히 낮아지고 아침"
"에 돌아옵니다."

#: src/prefs.js:105 src/lib/ui.js:264
msgid "Start"
msgstr "시작"

#: src/prefs.js:106
msgid "At sunset"
msgstr "해 질 때"

#: src/prefs.js:107
msgid "At a fixed time"
msgstr "정해진 시간"

#: src/prefs.js:109
msgid "Transition"
msgstr "전환 시간"

#: src/prefs.js:109
msgid "Minutes, for both evening and morning"
msgstr "분, 저녁과 아침 모두"

#: src/prefs.js:110 src/prefs.js:111
msgid "Morning"
msgstr "아침"

#: src/prefs.js:110
msgid "Minutes after sunrise"
msgstr "해 뜬 후 분"

#: src/prefs.js:111
msgid "Brightness comes back at"
msgstr "밝기가 돌아오는 시간"

#: src/prefs.js:117
msgid "For new monitors"
msgstr "새 모니터 기본값"

#: src/prefs.js:118
msgid "Each monitor can change these in its own menu."
msgstr "각 모니터의 메뉴에서 바꿀 수 있습니다."

#: src/prefs.js:120
msgid "Minutes after sunset"
msgstr "해 진 후 분"

#: src/prefs.js:121
msgid "Start time"
msgstr "시작 시간"

#: src/prefs.js:125 src/lib/ui.js:269
msgid "Night brightness"
msgstr "야간 밝기"

#: src/prefs.js:125
msgid "Percent"
msgstr "퍼센트"

#: src/prefs.js:134 src/prefs.js:137
msgid "Location"
msgstr "위치"

#: src/prefs.js:135
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"일몰과 일출 계산에만 사용됩니다. 자동: GNOME이 야간 모드용으로 저장한 위치, "
"없으면 시간대. 아무것도 전송되지 않습니다."

#: src/prefs.js:138
msgid "Automatic"
msgstr "자동"

#: src/prefs.js:139
msgid "Manual"
msgstr "수동"

#: src/prefs.js:141
msgid "Latitude"
msgstr "위도"

#: src/prefs.js:142
msgid "Longitude"
msgstr "경도"

#: src/prefs.js:145
msgid "Today"
msgstr "오늘"

#: src/prefs.js:162
msgid "manual"
msgstr "수동"

#: src/prefs.js:163
msgid "GNOME location"
msgstr "GNOME 위치"

#: src/prefs.js:164
#, javascript-format
msgid "time zone %s"
msgstr "시간대 %s"

#: src/prefs.js:165
msgid "UTC offset"
msgstr "UTC 차이"

#: src/prefs.js:168
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "일몰 %s · 일출 %s · 출처 %s"

#: src/prefs.js:176
msgid "Screen off"
msgstr "화면 끄기"

#: src/prefs.js:179 src/lib/ui.js:293
msgid "Turn off screen"
msgstr "화면 끄기"

#: src/prefs.js:180
msgid "“Turn off screen” and “Turn off others” in each monitor’s menu."
msgstr "각 모니터 메뉴의 “화면 끄기”와 “다른 화면 끄기”."

#: src/prefs.js:182
msgid "Turned off screen"
msgstr "꺼진 화면"

#: src/prefs.js:183
msgid "Fully black"
msgstr "완전히 검게"

#: src/prefs.js:184
msgid "Lowest light"
msgstr "최소 밝기"

#: src/prefs.js:186
msgid "Light left"
msgstr "남길 밝기"

#: src/prefs.js:186
msgid "Percent, for “Lowest light”"
msgstr "퍼센트, “최소 밝기”용"

#: src/prefs.js:188
msgid "Turn back on when the mouse comes"
msgstr "마우스가 오면 다시 켜기"

#: src/prefs.js:189
msgid "Moving the mouse onto a turned off screen brings its light back"
msgstr "꺼진 화면으로 마우스를 옮기면 밝기가 돌아옵니다"

#: src/prefs.js:196 src/lib/ui.js:429 src/lib/ui.js:490
msgid "Red screen"
msgstr "빨간 화면"

#: src/prefs.js:197
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr ""
"야간 모드 메뉴에서 켭니다. 모든 파란빛과 초록빛을 없애 잠들기 쉽게 합니다."

#: src/prefs.js:199
msgid "Only while Night Light is active"
msgstr "야간 모드가 켜져 있을 때만"

#: src/prefs.js:200
msgid "Starts and stops together with Night Light"
msgstr "야간 모드와 함께 시작하고 끝남"

#: src/prefs.js:201 src/lib/ui.js:439
msgid "Strength"
msgstr "강도"

#: src/prefs.js:215
msgid "Advanced"
msgstr "고급"

#: src/prefs.js:219
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"외부 모니터는 DDC/CI로 제어됩니다. 사용자에게 /dev/i2c-* 접근 권한(보통 "
"“i2c” 그룹)이 필요합니다."

#: src/prefs.js:223
msgid "ddcutil found"
msgstr "ddcutil 찾음"

#: src/prefs.js:223
msgid "ddcutil not found"
msgstr "ddcutil 없음"

#: src/prefs.js:224
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "배포판에서 ddcutil을 설치한 뒤 다시 검색을 누르세요"

#: src/prefs.js:226
msgid "Scan again"
msgstr "다시 검색"

#: src/prefs.js:231
msgid "ddcutil program"
msgstr "ddcutil 프로그램"

#: src/prefs.js:234
msgid "Extra arguments"
msgstr "추가 인수"

#: src/prefs.js:237
msgid "Pause between writes"
msgstr "쓰기 사이 간격"

#: src/prefs.js:238
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "밀리초. 모니터가 변경을 놓치면 늘리세요"

#: src/prefs.js:242
msgid "Debug messages"
msgstr "디버그 메시지"

#: src/prefs.js:242
msgid "Written to the system journal"
msgstr "시스템 저널에 기록됩니다"

#: src/lib/displays.js:37
msgid "Monitor"
msgstr "모니터"

#: src/lib/displays.js:287
msgid "Built-in Display"
msgstr "내장 디스플레이"

#: src/lib/displays.js:288
msgid "Built-in"
msgstr "내장"

#: src/lib/displays.js:290
#, javascript-format
msgid "Monitor %d"
msgstr "모니터 %d"

#: src/lib/ui.js:119
msgid "Earlier"
msgstr "더 일찍"

#: src/lib/ui.js:122
msgid "Later"
msgstr "더 늦게"

#: src/lib/ui.js:165
msgid "Evening dimming and more"
msgstr "저녁 어둡게 하기 등"

#: src/lib/ui.js:282
msgid "Extra dimming"
msgstr "추가 어둡게 하기"

#: src/lib/ui.js:294
msgid "Turn off others"
msgstr "다른 화면 끄기"

#: src/lib/ui.js:318
msgid "Off"
msgstr "끔"

#: src/lib/ui.js:335
msgid "Turned off"
msgstr "꺼짐"

#: src/lib/ui.js:335
#, javascript-format
msgid "Brightness %s"
msgstr "밝기 %s"

#: src/lib/ui.js:344
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "일몰 %s %s %d분"

#: src/lib/ui.js:347
msgid "Fixed time"
msgstr "정해진 시간"

#: src/lib/ui.js:421
msgid "Temperature"
msgstr "색온도"

#: src/lib/ui.js:498
msgid "Sunset to sunrise"
msgstr "일몰부터 일출까지"

#: src/lib/ui.js:514
msgid "Turns on together with Night Light"
msgstr "야간 모드와 함께 켜짐"

#: src/lib/ui.js:516
msgid "Starts when Night Light starts"
msgstr "야간 모드가 시작되면 시작"
