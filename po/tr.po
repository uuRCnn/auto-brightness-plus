#: src/prefs.js:127
msgid "General"
msgstr "Genel"

#: src/prefs.js:130
msgid "Claude Code"
msgstr "Claude Code"

#: src/prefs.js:131
msgid "Connect to Claude Code"
msgstr "Claude Code’a bağla"

#: src/prefs.js:132
msgid ""
"When Claude is done or asks you something, you get a notification and its "
"turned off screen lights up. No account needed."
msgstr ""
"Claude işini bitirince ya da sana bir şey sorunca bildirim gelir ve kapalı "
"ekranı yanar. Hesap gerekmez."

#: src/prefs.js:137
msgid "Connected"
msgstr "Bağlı"

#: src/prefs.js:137
