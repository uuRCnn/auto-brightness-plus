#, javascript-format
msgid "Monitor %d"
msgstr "Monitör %d"

#: src/lib/notify.js:115
msgid "Claude is waiting for you"
msgstr "Claude seni bekliyor"

#: src/lib/notify.js:115
msgid "Claude is done"
msgstr "Claude bitti"

#: src/lib/notify.js:129
msgid "Go to the terminal"
msgstr "Terminale git"

#: src/lib/offmenu.js:15
#, javascript-format
msgid "%d s"
msgstr "%d sn"

#: src/lib/offmenu.js:17
#, javascript-format
msgid "%d min %d s"
msgstr "%d dk %d sn"

