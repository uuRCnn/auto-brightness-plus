#: src/prefs.js:75
msgid "General"
msgstr "常规"

#: src/prefs.js:78
msgid "Sliders"
msgstr "滑块"

#: src/prefs.js:79
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr "每台显示器都会在快速设置中、音量滑块旁获得自己的滑块。"

#: src/prefs.js:81
msgid "Left of the slider"
msgstr "滑块左侧"

#: src/prefs.js:82
msgid "Brightness icon"
msgstr "亮度图标"

#: src/prefs.js:83
msgid "Monitor number (1, 2, 3…)"
msgstr "显示器编号（1、2、3…）"

#: src/prefs.js:84
msgid "Short name (LG, VS…)"
msgstr "简称（LG、VS…）"

#: src/prefs.js:86
msgid "Show the monitor name on hover"
msgstr "悬停时显示显示器名称"

#: src/prefs.js:87
msgid "Replace GNOME’s own brightness slider"
msgstr "替换 GNOME 自带的亮度滑块"

#: src/prefs.js:88
msgid "The laptop screen then gets a row like the other monitors"
msgstr "笔记本屏幕也会像其他显示器一样拥有一行"

#: src/prefs.js:91
msgid "Night Light"
msgstr "夜灯"

#: src/prefs.js:92
msgid "Add a menu to the Night Light button"
msgstr "为夜灯按钮添加菜单"

#: src/prefs.js:93
msgid "Temperature, red screen and its strength"
msgstr "色温、红屏及其强度"

#: src/prefs.js:99
msgid "Evening"
msgstr "傍晚"

#: src/prefs.js:102 src/lib/ui.js:257
msgid "Evening dimming"
msgstr "傍晚调暗"

#: src/prefs.js:103
msgid ""
"Turn it on per monitor with the moon button next to its slider. Brightness "
"goes down slowly in the evening and comes back in the morning."
msgstr "用滑块旁的月亮按钮为每台显示器单独开启。傍晚亮度缓慢降低，早晨恢复。"

#: src/prefs.js:105 src/lib/ui.js:264
msgid "Start"
msgstr "开始"

#: src/prefs.js:106
msgid "At sunset"
msgstr "日落时"

#: src/prefs.js:107
msgid "At a fixed time"
msgstr "固定时间"

#: src/prefs.js:109
msgid "Transition"
msgstr "过渡"

#: src/prefs.js:109
msgid "Minutes, for both evening and morning"
msgstr "分钟，傍晚和早晨都适用"

#: src/prefs.js:110 src/prefs.js:111
msgid "Morning"
msgstr "早晨"

#: src/prefs.js:110
msgid "Minutes after sunrise"
msgstr "日出后分钟数"

#: src/prefs.js:111
msgid "Brightness comes back at"
msgstr "亮度恢复时间"

#: src/prefs.js:117
msgid "For new monitors"
msgstr "新显示器的默认值"

#: src/prefs.js:118
msgid "Each monitor can change these in its own menu."
msgstr "每台显示器都可以在自己的菜单中修改。"

#: src/prefs.js:120
msgid "Minutes after sunset"
msgstr "日落后分钟数"

#: src/prefs.js:121
msgid "Start time"
msgstr "开始时间"

#: src/prefs.js:125 src/lib/ui.js:269
msgid "Night brightness"
msgstr "夜间亮度"

#: src/prefs.js:125
msgid "Percent"
msgstr "百分比"

#: src/prefs.js:134 src/prefs.js:137
msgid "Location"
msgstr "位置"

#: src/prefs.js:135
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"仅用于计算日落和日出。自动：使用 GNOME 为夜灯保存的位置，否则使用时区。不会发"
"送任何数据。"

#: src/prefs.js:138
msgid "Automatic"
msgstr "自动"

#: src/prefs.js:139
msgid "Manual"
msgstr "手动"

#: src/prefs.js:141
msgid "Latitude"
msgstr "纬度"

#: src/prefs.js:142
msgid "Longitude"
msgstr "经度"

#: src/prefs.js:145
msgid "Today"
msgstr "今天"

#: src/prefs.js:162
msgid "manual"
msgstr "手动"

#: src/prefs.js:163
msgid "GNOME location"
msgstr "GNOME 位置"

#: src/prefs.js:164
#, javascript-format
msgid "time zone %s"
msgstr "时区 %s"

#: src/prefs.js:165
msgid "UTC offset"
msgstr "UTC 偏移"

#: src/prefs.js:168
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "日落 %s · 日出 %s · 来自 %s"

#: src/prefs.js:176
msgid "Screen off"
msgstr "关闭屏幕"

#: src/prefs.js:179 src/lib/ui.js:293
msgid "Turn off screen"
msgstr "关闭屏幕"

#: src/prefs.js:180
msgid "“Turn off screen” and “Turn off others” in each monitor’s menu."
msgstr "每台显示器菜单中的“关闭屏幕”和“关闭其他屏幕”。"

#: src/prefs.js:182
msgid "Turned off screen"
msgstr "已关闭的屏幕"

#: src/prefs.js:183
msgid "Fully black"
msgstr "全黑"

#: src/prefs.js:184
msgid "Lowest light"
msgstr "最低亮度"

#: src/prefs.js:186
msgid "Light left"
msgstr "保留亮度"

#: src/prefs.js:186
msgid "Percent, for “Lowest light”"
msgstr "百分比，用于“最低亮度”"

#: src/prefs.js:188
msgid "Turn back on when the mouse comes"
msgstr "鼠标移入时重新点亮"

#: src/prefs.js:189
msgid "Moving the mouse onto a turned off screen brings its light back"
msgstr "将鼠标移到已关闭的屏幕上会恢复其亮度"

#: src/prefs.js:196 src/lib/ui.js:429 src/lib/ui.js:490
msgid "Red screen"
msgstr "红屏"

#: src/prefs.js:197
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr "在夜灯菜单中开启。去除所有蓝光和绿光，帮助入睡。"

#: src/prefs.js:199
msgid "Only while Night Light is active"
msgstr "仅在夜灯生效时"

#: src/prefs.js:200
msgid "Starts and stops together with Night Light"
msgstr "与夜灯一起开始和结束"

#: src/prefs.js:201 src/lib/ui.js:439
msgid "Strength"
msgstr "强度"

#: src/prefs.js:215
msgid "Advanced"
msgstr "高级"

#: src/prefs.js:219
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"外接显示器通过 DDC/CI 控制。用户需要能访问 /dev/i2c-*（通常是“i2c”组）。"

#: src/prefs.js:223
msgid "ddcutil found"
msgstr "已找到 ddcutil"

#: src/prefs.js:223
msgid "ddcutil not found"
msgstr "未找到 ddcutil"

#: src/prefs.js:224
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "请从发行版安装 ddcutil，然后点击“重新扫描”"

#: src/prefs.js:226
msgid "Scan again"
msgstr "重新扫描"

#: src/prefs.js:231
msgid "ddcutil program"
msgstr "ddcutil 程序"

#: src/prefs.js:234
msgid "Extra arguments"
msgstr "额外参数"

#: src/prefs.js:237
msgid "Pause between writes"
msgstr "写入间隔"

#: src/prefs.js:238
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "毫秒。如果显示器漏掉变化请调高"

#: src/prefs.js:242
msgid "Debug messages"
msgstr "调试消息"

#: src/prefs.js:242
msgid "Written to the system journal"
msgstr "写入系统日志"

#: src/lib/displays.js:37
msgid "Monitor"
msgstr "显示器"

#: src/lib/displays.js:287
msgid "Built-in Display"
msgstr "内置显示屏"

#: src/lib/displays.js:288
msgid "Built-in"
msgstr "内置"

#: src/lib/displays.js:290
#, javascript-format
msgid "Monitor %d"
msgstr "显示器 %d"

#: src/lib/ui.js:119
msgid "Earlier"
msgstr "提前"

#: src/lib/ui.js:122
msgid "Later"
msgstr "推后"

#: src/lib/ui.js:165
msgid "Evening dimming and more"
msgstr "傍晚调暗及更多"

#: src/lib/ui.js:282
msgid "Extra dimming"
msgstr "额外调暗"

#: src/lib/ui.js:294
msgid "Turn off others"
msgstr "关闭其他屏幕"

#: src/lib/ui.js:318
msgid "Off"
msgstr "关"

#: src/lib/ui.js:335
msgid "Turned off"
msgstr "已关闭"

#: src/lib/ui.js:335
#, javascript-format
msgid "Brightness %s"
msgstr "亮度 %s"

#: src/lib/ui.js:344
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "日落 %s %s %d 分钟"

#: src/lib/ui.js:347
msgid "Fixed time"
msgstr "固定时间"

#: src/lib/ui.js:421
msgid "Temperature"
msgstr "色温"

#: src/lib/ui.js:498
msgid "Sunset to sunrise"
msgstr "日落到日出"

#: src/lib/ui.js:514
msgid "Turns on together with Night Light"
msgstr "随夜灯一起开启"

#: src/lib/ui.js:516
msgid "Starts when Night Light starts"
msgstr "夜灯开始时开始"
