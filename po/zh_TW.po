#: src/prefs.js:75
msgid "General"
msgstr "一般"

#: src/prefs.js:78
msgid "Sliders"
msgstr "滑桿"

#: src/prefs.js:79
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr "每台螢幕都會在快速設定中、音量滑桿旁擁有自己的滑桿。"

#: src/prefs.js:81
msgid "Left of the slider"
msgstr "滑桿左側"

#: src/prefs.js:82
msgid "Brightness icon"
msgstr "亮度圖示"

#: src/prefs.js:83
msgid "Monitor number (1, 2, 3…)"
msgstr "螢幕編號（1、2、3…）"

#: src/prefs.js:84
msgid "Short name (LG, VS…)"
msgstr "簡稱（LG、VS…）"

#: src/prefs.js:86
msgid "Show the monitor name on hover"
msgstr "滑鼠停留時顯示螢幕名稱"

#: src/prefs.js:87
msgid "Replace GNOME’s own brightness slider"
msgstr "取代 GNOME 內建的亮度滑桿"

#: src/prefs.js:88
msgid "The laptop screen then gets a row like the other monitors"
msgstr "筆電螢幕也會像其他螢幕一樣擁有一列"

#: src/prefs.js:91
msgid "Night Light"
msgstr "夜光"

#: src/prefs.js:92
msgid "Add a menu to the Night Light button"
msgstr "為夜光按鈕加入選單"

#: src/prefs.js:93
msgid "Temperature, red screen and its strength"
msgstr "色溫、紅色螢幕及其強度"

#: src/prefs.js:99
msgid "Evening"
msgstr "傍晚"

#: src/prefs.js:102 src/lib/ui.js:257
msgid "Evening dimming"
msgstr "傍晚調暗"

#: src/prefs.js:103
msgid ""
"Turn it on per monitor with the moon button next to its slider. Brightness "
"goes down slowly in the evening and comes back in the morning."
msgstr "用滑桿旁的月亮按鈕為每台螢幕個別開啟。傍晚亮度緩慢降低，早上恢復。"

#: src/prefs.js:105 src/lib/ui.js:264
msgid "Start"
msgstr "開始"

#: src/prefs.js:106
msgid "At sunset"
msgstr "日落時"

#: src/prefs.js:107
msgid "At a fixed time"
msgstr "固定時間"

#: src/prefs.js:109
msgid "Transition"
msgstr "過渡"

#: src/prefs.js:109
msgid "Minutes, for both evening and morning"
msgstr "分鐘，傍晚與早上皆適用"

#: src/prefs.js:110 src/prefs.js:111
msgid "Morning"
msgstr "早上"

#: src/prefs.js:110
msgid "Minutes after sunrise"
msgstr "日出後分鐘數"

#: src/prefs.js:111
msgid "Brightness comes back at"
msgstr "亮度恢復時間"

#: src/prefs.js:117
msgid "For new monitors"
msgstr "新螢幕的預設值"

#: src/prefs.js:118
msgid "Each monitor can change these in its own menu."
msgstr "每台螢幕都可在自己的選單中修改。"

#: src/prefs.js:120
msgid "Minutes after sunset"
msgstr "日落後分鐘數"

#: src/prefs.js:121
msgid "Start time"
msgstr "開始時間"

#: src/prefs.js:125 src/lib/ui.js:269
msgid "Night brightness"
msgstr "夜間亮度"

#: src/prefs.js:125
msgid "Percent"
msgstr "百分比"

#: src/prefs.js:134 src/prefs.js:137
msgid "Location"
msgstr "位置"

#: src/prefs.js:135
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"僅用於計算日落與日出。自動：使用 GNOME 為夜光保存的位置，否則使用時區。不會傳"
"送任何資料。"

#: src/prefs.js:138
msgid "Automatic"
msgstr "自動"

#: src/prefs.js:139
msgid "Manual"
msgstr "手動"

#: src/prefs.js:141
msgid "Latitude"
msgstr "緯度"

#: src/prefs.js:142
msgid "Longitude"
msgstr "經度"

#: src/prefs.js:145
msgid "Today"
msgstr "今天"

#: src/prefs.js:162
msgid "manual"
msgstr "手動"

#: src/prefs.js:163
msgid "GNOME location"
msgstr "GNOME 位置"

#: src/prefs.js:164
#, javascript-format
msgid "time zone %s"
msgstr "時區 %s"

#: src/prefs.js:165
msgid "UTC offset"
msgstr "UTC 偏移"

#: src/prefs.js:168
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "日落 %s · 日出 %s · 來源 %s"

#: src/prefs.js:176
msgid "Screen off"
msgstr "關閉螢幕"

#: src/prefs.js:179 src/lib/ui.js:293
msgid "Turn off screen"
msgstr "關閉螢幕"

#: src/prefs.js:180
msgid "“Turn off screen” and “Turn off others” in each monitor’s menu."
msgstr "每台螢幕選單中的「關閉螢幕」與「關閉其他螢幕」。"

#: src/prefs.js:182
msgid "Turned off screen"
msgstr "已關閉的螢幕"

#: src/prefs.js:183
msgid "Fully black"
msgstr "全黑"

#: src/prefs.js:184
msgid "Lowest light"
msgstr "最低亮度"

#: src/prefs.js:186
msgid "Light left"
msgstr "保留亮度"

#: src/prefs.js:186
msgid "Percent, for “Lowest light”"
msgstr "百分比，用於「最低亮度」"

#: src/prefs.js:188
msgid "Turn back on when the mouse comes"
msgstr "滑鼠移入時重新點亮"

#: src/prefs.js:189
msgid "Moving the mouse onto a turned off screen brings its light back"
msgstr "將滑鼠移到已關閉的螢幕上會恢復其亮度"

#: src/prefs.js:196 src/lib/ui.js:429 src/lib/ui.js:490
msgid "Red screen"
msgstr "紅色螢幕"

#: src/prefs.js:197
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr "在夜光選單中開啟。去除所有藍光與綠光，幫助入睡。"

#: src/prefs.js:199
msgid "Only while Night Light is active"
msgstr "僅在夜光作用時"

#: src/prefs.js:200
msgid "Starts and stops together with Night Light"
msgstr "與夜光一起開始和結束"

#: src/prefs.js:201 src/lib/ui.js:439
msgid "Strength"
msgstr "強度"

#: src/prefs.js:215
msgid "Advanced"
msgstr "進階"

#: src/prefs.js:219
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"外接螢幕透過 DDC/CI 控制。使用者需要能存取 /dev/i2c-*（通常是「i2c」群組）。"

#: src/prefs.js:223
msgid "ddcutil found"
msgstr "已找到 ddcutil"

#: src/prefs.js:223
msgid "ddcutil not found"
msgstr "找不到 ddcutil"

#: src/prefs.js:224
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "請從發行版安裝 ddcutil，然後按「重新掃描」"

#: src/prefs.js:226
msgid "Scan again"
msgstr "重新掃描"

#: src/prefs.js:231
msgid "ddcutil program"
msgstr "ddcutil 程式"

#: src/prefs.js:234
msgid "Extra arguments"
msgstr "額外參數"

#: src/prefs.js:237
msgid "Pause between writes"
msgstr "寫入間隔"

#: src/prefs.js:238
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "毫秒。如果螢幕漏掉變化請調高"

#: src/prefs.js:242
msgid "Debug messages"
msgstr "除錯訊息"

#: src/prefs.js:242
msgid "Written to the system journal"
msgstr "寫入系統日誌"

#: src/lib/displays.js:37
msgid "Monitor"
msgstr "螢幕"

#: src/lib/displays.js:287
msgid "Built-in Display"
msgstr "內建螢幕"

#: src/lib/displays.js:288
msgid "Built-in"
msgstr "內建"

#: src/lib/displays.js:290
#, javascript-format
msgid "Monitor %d"
msgstr "螢幕 %d"

#: src/lib/ui.js:119
msgid "Earlier"
msgstr "提早"

#: src/lib/ui.js:122
msgid "Later"
msgstr "延後"

#: src/lib/ui.js:165
msgid "Evening dimming and more"
msgstr "傍晚調暗及更多"

#: src/lib/ui.js:282
msgid "Extra dimming"
msgstr "額外調暗"

#: src/lib/ui.js:294
msgid "Turn off others"
msgstr "關閉其他螢幕"

#: src/lib/ui.js:318
msgid "Off"
msgstr "關"

#: src/lib/ui.js:335
msgid "Turned off"
msgstr "已關閉"

#: src/lib/ui.js:335
#, javascript-format
msgid "Brightness %s"
msgstr "亮度 %s"

#: src/lib/ui.js:344
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "日落 %s %s %d 分鐘"

#: src/lib/ui.js:347
msgid "Fixed time"
msgstr "固定時間"

#: src/lib/ui.js:421
msgid "Temperature"
msgstr "色溫"

#: src/lib/ui.js:498
msgid "Sunset to sunrise"
msgstr "日落到日出"

#: src/lib/ui.js:514
msgid "Turns on together with Night Light"
msgstr "隨夜光一起開啟"

#: src/lib/ui.js:516
msgid "Starts when Night Light starts"
msgstr "夜光開始時開始"
