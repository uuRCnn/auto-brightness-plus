#: src/prefs.js:62 src/prefs.js:94
msgid "None"
msgstr "無"

#: src/prefs.js:91
msgid "Press the keys…"
msgstr "請按鍵…"

#: src/prefs.js:127
msgid "General"
msgstr "一般"

#: src/prefs.js:130
msgid "Claude Code"
msgstr "Claude Code"

#: src/prefs.js:131
msgid "Connect to Claude Code"
msgstr "連接到 Claude Code"

#: src/prefs.js:132
msgid ""
"When Claude is done or asks you something, you get a notification and its "
"turned off screen lights up. No account needed."
msgstr ""
"Claude 完成或向你提問時，你會收到通知，它所在的關閉螢幕會亮起。不需帳號。"

#: src/prefs.js:137
msgid "Connected"
msgstr "已連接"

#: src/prefs.js:137
msgid "Not connected"
msgstr "未連接"

#: src/prefs.js:138
msgid "Disconnect"
msgstr "中斷連接"

#: src/prefs.js:138
msgid "Connect"
msgstr "連接"

#: src/prefs.js:149
#, javascript-format
msgid "Could not change %s: %s"
msgstr "無法修改 %s：%s"

#: src/prefs.js:154
msgid "When Claude is done"
msgstr "Claude 完成時"

#: src/prefs.js:155
msgid "When Claude waits for you"
msgstr "Claude 等你時"

#: src/prefs.js:155
msgid "A permission or a question"
msgstr "權限請求或問題"

#: src/prefs.js:156
msgid "Also a notification"
msgstr "同時顯示通知"

#: src/prefs.js:156
msgid "Click it to go to the terminal"
msgstr "點擊前往終端機"

#: src/prefs.js:157
msgid "Other programs too"
msgstr "其他程式也一樣"

#: src/prefs.js:158
msgid ""
"Terminal bell or an app asking for attention, e.g. make ; printf \"\\a\""
msgstr "終端機響鈴或請求注意的應用程式，例如 make ; printf \"\\a\""

#: src/prefs.js:163
msgid "Sliders"
msgstr "滑桿"

#: src/prefs.js:164
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr "每台螢幕都會在快速設定中、音量滑桿旁擁有自己的滑桿。"

#: src/prefs.js:166
msgid "Monitor menu"
msgstr "螢幕選單"

#: src/prefs.js:167
msgid "Simple (recommended)"
msgstr "簡潔（推薦）"

#: src/prefs.js:168
msgid "Detailed"
msgstr "詳細"

#: src/prefs.js:169
msgid ""
"Simple: one slider for the value you pick. Detailed: a slider for every "
"value."
msgstr "簡潔：為所選的值提供一個滑桿。詳細：每個值都有滑桿。"

#: src/prefs.js:170
msgid "Left of the slider"
msgstr "滑桿左側"

#: src/prefs.js:171
msgid "Brightness icon"
msgstr "亮度圖示"

#: src/prefs.js:172
msgid "Monitor number (1, 2, 3…)"
msgstr "螢幕編號（1、2、3…）"

#: src/prefs.js:173
msgid "Short name (LG, VS…)"
msgstr "簡稱（LG、VS…）"

#: src/prefs.js:175
msgid "Show the monitor name on hover"
msgstr "滑鼠停留時顯示螢幕名稱"

#: src/prefs.js:176
msgid "Replace GNOME’s own brightness slider"
msgstr "取代 GNOME 內建的亮度滑桿"

#: src/prefs.js:177
msgid "The laptop screen then gets a row like the other monitors"
msgstr "筆電螢幕也會像其他螢幕一樣擁有一列"

#: src/prefs.js:180
msgid "Night Light"
msgstr "夜光"

#: src/prefs.js:181
msgid "Add a menu to the Night Light button"
msgstr "為夜光按鈕加入選單"

#: src/prefs.js:182
msgid "Temperature, red screen and its strength"
msgstr "色溫、紅色螢幕及其強度"

#: src/prefs.js:188
msgid "Evening"
msgstr "傍晚"

#: src/prefs.js:191 src/lib/ui.js:1293
msgid "Automatic dimming"
msgstr "自動調暗"

#: src/prefs.js:192
msgid ""
"Turn it on per monitor with the moon button next to its slider. The monitor "
"slowly gets darker and warmer in the evening and comes back in the morning."
msgstr "在每個螢幕滑桿旁的月亮按鈕中開啟。螢幕會在傍晚慢慢變暗變暖，早上恢復。"

#: src/prefs.js:194 src/lib/ui.js:1311
msgid "Start"
msgstr "開始"

#: src/prefs.js:195
msgid "At sunset"
msgstr "日落時"

#: src/prefs.js:196
msgid "At a fixed time"
msgstr "固定時間"

#: src/prefs.js:198
msgid "Morning transition"
msgstr "早晨過渡"

#: src/prefs.js:198
msgid "Minutes"
msgstr "分鐘"

#: src/prefs.js:199 src/prefs.js:200
msgid "Morning"
msgstr "早上"

#: src/prefs.js:199
msgid "Minutes after sunrise"
msgstr "日出後分鐘數"

#: src/prefs.js:200
msgid "Brightness comes back at"
msgstr "亮度恢復時間"

#: src/prefs.js:206
msgid "For new monitors"
msgstr "新螢幕的預設值"

#: src/prefs.js:207
msgid ""
"For the main monitor. The others take 30 minutes longer and go down to 0 %, "
"with a little extra dimming late at night. Each monitor can change these in "
"its own menu."
msgstr ""
"用於主螢幕。其他螢幕多 30 分鐘，降到 0 %，深夜還會稍加額外調暗。每個螢幕都可"
"以在自己的選單中更改。"

#: src/prefs.js:209
msgid "Minutes after sunset"
msgstr "日落後分鐘數"

#: src/prefs.js:210
msgid "Start time"
msgstr "開始時間"

#: src/prefs.js:213 src/lib/ui.js:1316
msgid "Duration"
msgstr "時長"

#: src/prefs.js:213
msgid "Minutes the evening dimming takes"
msgstr "傍晚調暗持續的分鐘數"

#: src/prefs.js:215 src/lib/ui.js:37
msgid "Night brightness"
msgstr "夜間亮度"

#: src/prefs.js:215
msgid "Percent"
msgstr "百分比"

#: src/prefs.js:224 src/prefs.js:227
msgid "Location"
msgstr "位置"

#: src/prefs.js:225
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"僅用於計算日落與日出。自動：使用 GNOME 為夜光保存的位置，否則使用時區。不會傳"
"送任何資料。"

#: src/prefs.js:228
msgid "Automatic"
msgstr "自動"

#: src/prefs.js:229
msgid "Manual"
msgstr "手動"

#: src/prefs.js:231
msgid "Latitude"
msgstr "緯度"

#: src/prefs.js:232
msgid "Longitude"
msgstr "經度"

#: src/prefs.js:235
msgid "Today"
msgstr "今天"

#: src/prefs.js:252
msgid "manual"
msgstr "手動"

#: src/prefs.js:253
msgid "GNOME location"
msgstr "GNOME 位置"

#: src/prefs.js:254
#, javascript-format
msgid "time zone %s"
msgstr "時區 %s"

#: src/prefs.js:255
msgid "UTC offset"
msgstr "UTC 偏移"

#: src/prefs.js:258
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "日落 %s · 日出 %s · 來源 %s"

#: src/prefs.js:266
msgid "Screen off"
msgstr "關閉螢幕"

#: src/prefs.js:269
msgid "Buttons"
msgstr "按鈕"

#: src/prefs.js:270
msgid "In each monitor’s menu (the moon button)."
msgstr "在每個螢幕的選單中（月亮按鈕）。"

#: src/prefs.js:272
msgid "Place"
msgstr "位置"

#: src/prefs.js:273
msgid "At the bottom, large"
msgstr "底部，大"

#: src/prefs.js:274
msgid "At the top, large"
msgstr "頂部，大"

#: src/prefs.js:275
msgid "Next to the monitor name, small"
msgstr "螢幕名稱旁，小"

#: src/prefs.js:277 src/lib/ui.js:340 src/lib/ui.js:1626 src/lib/ui.js:1697
msgid "Lowest light"
msgstr "最低亮度"

#: src/prefs.js:278
msgid "Brightness 0 and full extra dimming; press again to go back"
msgstr "亮度 0 並完全額外調暗；再按一次恢復"

#: src/prefs.js:279 src/prefs.js:285 src/lib/offmenu.js:48 src/lib/ui.js:341
#: src/lib/ui.js:1629
msgid "Turn off screen"
msgstr "關閉螢幕"

#: src/prefs.js:280 src/lib/offmenu.js:49 src/lib/ui.js:342 src/lib/ui.js:1640
msgid "Turn off other screens"
msgstr "關閉其他螢幕"

#: src/prefs.js:281
msgid "Press again to turn them back on"
msgstr "再按一次重新開啟"

#: src/prefs.js:286
msgid "“Turn off screen” and “Turn off other screens” in each monitor’s menu."
msgstr "每個螢幕選單中的「關閉螢幕」和「關閉其他螢幕」。"

#: src/prefs.js:288
msgid "Light up while the mouse is on it"
msgstr "滑鼠在上面時亮起"

#: src/prefs.js:289
msgid ""
"A turned off screen lights up while the mouse is on it and goes dark again "
"when the mouse leaves. The same button turns it back on."
msgstr ""
"關閉的螢幕在滑鼠停在上面時亮起，滑鼠離開後再次變暗。同一個按鈕可以重新開啟"
"它。"

#: src/prefs.js:294
msgid "A turned off screen"
msgstr "關閉的螢幕"

#: src/prefs.js:295
msgid ""
"Clicks and typing always reach the apps on it. Its options are in the "
"monitor’s menu (the moon button) and behind the small dot."
msgstr ""
"點擊和輸入一律會傳到其上的應用程式。它的選項在螢幕選單（月亮按鈕）和小圓點"
"裡。"

#: src/prefs.js:297
msgid "Small dot in a corner"
msgstr "角落的小圓點"

#: src/prefs.js:298
msgid "Click it for the screen’s menu; drag it to another corner"
msgstr "點擊：螢幕選單；拖曳：移到另一個角"

#: src/prefs.js:299
msgid "Keyboard shortcut"
msgstr "鍵盤快捷鍵"

#: src/prefs.js:300
msgid "The menu of the screen under the mouse"
msgstr "滑鼠所在螢幕的選單"

#: src/prefs.js:301
msgid "“Keep lit” lasts"
msgstr "「保持亮起」時長"

#: src/prefs.js:301
msgid "Seconds"
msgstr "秒"

#: src/prefs.js:305 src/lib/ui.js:1842 src/lib/ui.js:1917
msgid "Red screen"
msgstr "紅色螢幕"

#: src/prefs.js:306
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr "在夜光選單中開啟。去除所有藍光與綠光，幫助入睡。"

#: src/prefs.js:308
msgid "Only while Night Light is active"
msgstr "僅在夜光作用時"

#: src/prefs.js:309
msgid "Starts and stops together with Night Light"
msgstr "與夜光一起開始和結束"

#: src/prefs.js:310 src/lib/ui.js:1858
msgid "Strength"
msgstr "強度"

#: src/prefs.js:324
msgid "Advanced"
msgstr "進階"

#: src/prefs.js:328
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"外接螢幕透過 DDC/CI 控制。使用者需要能存取 /dev/i2c-*（通常是「i2c」群組）。"

#: src/prefs.js:332
msgid "ddcutil found"
msgstr "已找到 ddcutil"

#: src/prefs.js:332
msgid "ddcutil not found"
msgstr "找不到 ddcutil"

#: src/prefs.js:333
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "請從發行版安裝 ddcutil，然後按「重新掃描」"

#: src/prefs.js:335
msgid "Scan again"
msgstr "重新掃描"

#: src/prefs.js:340
msgid "ddcutil program"
msgstr "ddcutil 程式"

#: src/prefs.js:343
msgid "Extra arguments"
msgstr "額外參數"

#: src/prefs.js:346
msgid "Pause between writes"
msgstr "寫入間隔"

#: src/prefs.js:347
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "毫秒。如果螢幕漏掉變化請調高"

#: src/prefs.js:351
msgid "Debug messages"
msgstr "除錯訊息"

#: src/prefs.js:351
msgid "Written to the system journal"
msgstr "寫入系統日誌"

#: src/lib/cornerdot.js:61
msgid "Screen menu"
msgstr "螢幕選單"

#: src/lib/displays.js:59
msgid "Monitor"
msgstr "螢幕"

#: src/lib/displays.js:415
msgid "Built-in Display"
msgstr "內建螢幕"

#: src/lib/displays.js:416
msgid "Built-in"
msgstr "內建"

#: src/lib/displays.js:418
#, javascript-format
msgid "Monitor %d"
msgstr "螢幕 %d"

#: src/lib/notify.js:115
msgid "Claude is waiting for you"
msgstr "Claude 在等你"

#: src/lib/notify.js:115
msgid "Claude is done"
msgstr "Claude 已完成"

#: src/lib/notify.js:129
msgid "Go to the terminal"
msgstr "前往終端機"

#: src/lib/offmenu.js:15
#, javascript-format
msgid "%d s"
msgstr "%d 秒"

#: src/lib/offmenu.js:17
#, javascript-format
msgid "%d min %d s"
msgstr "%d 分 %d 秒"

#: src/lib/offmenu.js:17 src/lib/ui.js:62
#, javascript-format
msgid "%d min"
msgstr "%d 分鐘"

#: src/lib/offmenu.js:43
#, javascript-format
msgid "Keep lit · %s"
msgstr "保持亮起 · %s"

#: src/lib/offmenu.js:44
msgid "Keep lit until I darken it"
msgstr "保持亮起直到我調暗"

#: src/lib/offmenu.js:45
msgid "Darken now"
msgstr "立即變暗"

#: src/lib/offmenu.js:46
msgid "Turn the screen back on"
msgstr "重新開啟螢幕"

#: src/lib/ui.js:36
msgid "Day brightness"
msgstr "白天亮度"

#: src/lib/ui.js:38
msgid "Extra dimming"
msgstr "額外調暗"

#: src/lib/ui.js:39
msgid ""
"Darkens the picture further when the monitor is already at its lowest "
"brightness."
msgstr "當螢幕已是最低亮度時，進一步調暗畫面。"

#: src/lib/ui.js:45
msgid "Night light"
msgstr "夜燈"

#: src/lib/ui.js:46 src/lib/ui.js:1830
msgid ""
"Blue light in the evening holds back melatonin, the sleep hormone. A warmer "
"screen helps you fall asleep more easily."
msgstr "晚上的藍光會抑制睡眠荷爾蒙褪黑激素。更暖的螢幕能幫助你更容易入睡。"

#: src/lib/ui.js:47
msgid ""
"How strong Night Light is on this monitor. ×1 = exactly GNOME’s Night Light, "
"nothing added. ×0 turns it off here, ×2 makes it twice as warm."
msgstr ""
"夜燈在這台螢幕上的強度。×1 = 與 GNOME 夜燈完全相同，不額外增加。×0 在此關閉，"
"×2 加倍變暖。"

#: src/lib/ui.js:48
msgid "Red light"
msgstr "紅光"

#: src/lib/ui.js:49 src/lib/ui.js:1847
msgid ""
"Red light disturbs melatonin and your body clock the least of all colours. "
"Ideal for the last hours before bed."
msgstr ""
"在所有顏色中，紅光對褪黑激素和生理時鐘的影響最小。最適合睡前的最後幾個小時。"

#: src/lib/ui.js:50
msgid ""
"How strong the red screen is on this monitor. ×1 = the red screen as set in "
"the Night Light menu, nothing added. ×0 keeps this monitor normal, ×2 makes "
"it twice as red."
msgstr ""
"紅色螢幕在這台螢幕上的強度。×1 = 夜燈選單中設定的紅色螢幕，不額外增加。×0 保"
"持正常，×2 加倍變紅。"

#: src/lib/ui.js:63
#, javascript-format
msgid "%d h %d min"
msgstr "%d 小時 %d 分鐘"

#: src/lib/ui.js:63
#, javascript-format
msgid "%d h"
msgstr "%d 小時"

#: src/lib/ui.js:284
msgid "Earlier"
msgstr "提早"

#: src/lib/ui.js:287
msgid "Later"
msgstr "延後"

#: src/lib/ui.js:1086
msgid "Automatic dimming and more"
msgstr "自動調暗及更多"

#: src/lib/ui.js:1255
msgid "Settings"
msgstr "設定"

#: src/lib/ui.js:1299
msgid ""
"Slowly dims this monitor in the evening, and brings it back in the morning."
msgstr "傍晚慢慢調暗這台螢幕，早上恢復原樣。"

#: src/lib/ui.js:1300
msgid ""
"Drag the points to shape the evening; the big point also sets how long it "
"takes. + adds a button that runs by itself."
msgstr "拖曳這些點來塑造夜晚；大點同時決定持續多久。+ 可加入自動執行的按鈕。"

#: src/lib/ui.js:1317
msgid "Shorter"
msgstr "更短"

#: src/lib/ui.js:1318
msgid "Longer"
msgstr "更長"

#: src/lib/ui.js:1328
msgid "Back to normal in the morning"
msgstr "早上恢復正常"

#: src/lib/ui.js:1332
msgid ""
"When the morning comes, lowest light and turned off screens go back to "
"normal, whether they were switched on by hand or by the graph."
msgstr "早上，最低亮度和關閉的螢幕會恢復正常，無論是手動還是由圖表開啟的。"

#: src/lib/ui.js:1365
msgid "Back to 100 %"
msgstr "恢復為 100 %"

#: src/lib/ui.js:1368 src/lib/ui.js:1370
msgid "Back to the default evening curve"
msgstr "恢復預設的夜晚曲線"

#: src/lib/ui.js:1386
msgid "Back to the default: ×1 and GNOME’s automatic time (sunset)"
msgstr "恢復預設：×1 和 GNOME 的自動時間（日落）"

#: src/lib/ui.js:1391
msgid "Back to ×1"
msgstr "恢復為 ×1"

#: src/lib/ui.js:1409
msgid "Day"
msgstr "白天"

#: src/lib/ui.js:1409
msgid "Night"
msgstr "夜晚"

#: src/lib/ui.js:1409
msgid "Extra"
msgstr "額外"

#: src/lib/ui.js:1410
msgid "Warmth"
msgstr "暖色"

#: src/lib/ui.js:1410
msgid "Red"
msgstr "紅色"

#: src/lib/ui.js:1442 src/lib/ui.js:1591 src/lib/ui.js:1860
msgid "Back to the default"
msgstr "恢復預設"

#: src/lib/ui.js:1547
msgid "While the screen is off"
msgstr "螢幕關閉時"

#: src/lib/ui.js:1587
msgid "Dark while off"
msgstr "關閉時的黑暗程度"

#: src/lib/ui.js:1588
msgid ""
"While the screen is off, the monitor stays at its lowest light and this much "
"black is added on top. 25 % = a little darker, 100 % = fully black."
msgstr ""
"螢幕關閉時，螢幕保持最低亮度，並在上面疊加這麼多黑色。25 % = 稍暗一些，100 % "
"= 全黑。"

#: src/lib/ui.js:1608
#, javascript-format
msgid "Keep lit for %s"
msgstr "保持亮起 %s"

#: src/lib/ui.js:1609
#, javascript-format
msgid ""
"On: after the mouse leaves, the screen stays lit for %s, then goes dark. "
"Off: it goes dark as soon as the mouse leaves."
msgstr "開：滑鼠離開後，螢幕再亮 %s，然後變暗。關：滑鼠一離開就變暗。"

#: src/lib/ui.js:1693
#, javascript-format
msgid "Brightness %s"
msgstr "亮度 %s"

#: src/lib/ui.js:1695
msgid "Turned off"
msgstr "已關閉"

#: src/lib/ui.js:1715
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "日落 %s %s %d 分鐘"

#: src/lib/ui.js:1718
msgid "Fixed time"
msgstr "固定時間"

#: src/lib/ui.js:1721
#, javascript-format
msgid "Until %s"
msgstr "到 %s"

#: src/lib/ui.js:1730
msgid "Off"
msgstr "關"

#: src/lib/ui.js:1828
msgid "Temperature"
msgstr "色溫"

#: src/lib/ui.js:1831
msgid "Back to GNOME’s default"
msgstr "恢復 GNOME 預設值"

#: src/lib/ui.js:1925
msgid "Sunset to sunrise"
msgstr "日落到日出"

#: src/lib/ui.js:1947
msgid "Turns on together with Night Light"
msgstr "隨夜光一起開啟"

#: src/lib/ui.js:1949
msgid "Starts when Night Light starts"
msgstr "夜光開始時開始"
