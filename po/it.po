#: src/prefs.js:75
msgid "General"
msgstr "Generale"

#: src/prefs.js:78
msgid "Sliders"
msgstr "Cursori"

#: src/prefs.js:79
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr ""
"Ogni monitor ha il suo cursore nelle Impostazioni rapide, accanto al volume."

#: src/prefs.js:81
msgid "Left of the slider"
msgstr "A sinistra del cursore"

#: src/prefs.js:82
msgid "Brightness icon"
msgstr "Icona luminosità"

#: src/prefs.js:83
msgid "Monitor number (1, 2, 3…)"
msgstr "Numero del monitor (1, 2, 3…)"

#: src/prefs.js:84
msgid "Short name (LG, VS…)"
msgstr "Nome breve (LG, VS…)"

#: src/prefs.js:86
msgid "Show the monitor name on hover"
msgstr "Mostra il nome del monitor al passaggio del mouse"

#: src/prefs.js:87
msgid "Replace GNOME’s own brightness slider"
msgstr "Sostituisci il cursore di luminosità di GNOME"

#: src/prefs.js:88
msgid "The laptop screen then gets a row like the other monitors"
msgstr "Lo schermo del portatile avrà una riga come gli altri monitor"

#: src/prefs.js:91
msgid "Night Light"
msgstr "Luce notturna"

#: src/prefs.js:92
msgid "Add a menu to the Night Light button"
msgstr "Aggiungi un menu al pulsante Luce notturna"

#: src/prefs.js:93
msgid "Temperature, red screen and its strength"
msgstr "Temperatura, schermo rosso e la sua intensità"

#: src/prefs.js:99
msgid "Evening"
msgstr "Sera"

#: src/prefs.js:102 src/lib/ui.js:257
msgid "Evening dimming"
msgstr "Attenuazione serale"

#: src/prefs.js:103
msgid ""
"Turn it on per monitor with the moon button next to its slider. Brightness "
"goes down slowly in the evening and comes back in the morning."
msgstr ""
"Attivala per ogni monitor con il pulsante luna accanto al cursore. La "
"luminosità scende piano la sera e torna al mattino."

#: src/prefs.js:105 src/lib/ui.js:264
msgid "Start"
msgstr "Inizio"

#: src/prefs.js:106
msgid "At sunset"
msgstr "Al tramonto"

#: src/prefs.js:107
msgid "At a fixed time"
msgstr "A un orario fisso"

#: src/prefs.js:109
msgid "Transition"
msgstr "Transizione"

#: src/prefs.js:109
msgid "Minutes, for both evening and morning"
msgstr "Minuti, per sera e mattina"

#: src/prefs.js:110 src/prefs.js:111
msgid "Morning"
msgstr "Mattina"

#: src/prefs.js:110
msgid "Minutes after sunrise"
msgstr "Minuti dopo l’alba"

#: src/prefs.js:111
msgid "Brightness comes back at"
msgstr "La luminosità torna alle"

#: src/prefs.js:117
msgid "For new monitors"
msgstr "Per i nuovi monitor"

#: src/prefs.js:118
msgid "Each monitor can change these in its own menu."
msgstr "Ogni monitor può cambiarli nel proprio menu."

#: src/prefs.js:120
msgid "Minutes after sunset"
msgstr "Minuti dopo il tramonto"

#: src/prefs.js:121
msgid "Start time"
msgstr "Orario di inizio"

#: src/prefs.js:125 src/lib/ui.js:269
msgid "Night brightness"
msgstr "Luminosità notturna"

#: src/prefs.js:125
msgid "Percent"
msgstr "Percentuale"

#: src/prefs.js:134 src/prefs.js:137
msgid "Location"
msgstr "Posizione"

#: src/prefs.js:135
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"Usata solo per calcolare tramonto e alba. Automatica usa la posizione che "
"GNOME tiene per la Luce notturna, altrimenti il fuso orario. Non viene "
"inviato nulla."

#: src/prefs.js:138
msgid "Automatic"
msgstr "Automatica"

#: src/prefs.js:139
msgid "Manual"
msgstr "Manuale"

#: src/prefs.js:141
msgid "Latitude"
msgstr "Latitudine"

#: src/prefs.js:142
msgid "Longitude"
msgstr "Longitudine"

#: src/prefs.js:145
msgid "Today"
msgstr "Oggi"

#: src/prefs.js:162
msgid "manual"
msgstr "manuale"

#: src/prefs.js:163
msgid "GNOME location"
msgstr "posizione di GNOME"

#: src/prefs.js:164
#, javascript-format
msgid "time zone %s"
msgstr "fuso orario %s"

#: src/prefs.js:165
msgid "UTC offset"
msgstr "differenza UTC"

#: src/prefs.js:168
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "Tramonto %s · alba %s · da %s"

#: src/prefs.js:176
msgid "Screen off"
msgstr "Spegnimento"

#: src/prefs.js:179 src/lib/ui.js:293
msgid "Turn off screen"
msgstr "Spegni schermo"

#: src/prefs.js:180
msgid "“Turn off screen” and “Turn off others” in each monitor’s menu."
msgstr "«Spegni schermo» e «Spegni gli altri» nel menu di ogni monitor."

#: src/prefs.js:182
msgid "Turned off screen"
msgstr "Schermo spento"

#: src/prefs.js:183
msgid "Fully black"
msgstr "Completamente nero"

#: src/prefs.js:184
msgid "Lowest light"
msgstr "Luce minima"

#: src/prefs.js:186
msgid "Light left"
msgstr "Luce rimasta"

#: src/prefs.js:186
msgid "Percent, for “Lowest light”"
msgstr "Percentuale, per «Luce minima»"

#: src/prefs.js:188
msgid "Turn back on when the mouse comes"
msgstr "Riaccendi quando arriva il mouse"

#: src/prefs.js:189
msgid "Moving the mouse onto a turned off screen brings its light back"
msgstr "Portare il mouse su uno schermo spento gli ridà la luce"

#: src/prefs.js:196 src/lib/ui.js:429 src/lib/ui.js:490
msgid "Red screen"
msgstr "Schermo rosso"

#: src/prefs.js:197
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr ""
"Si attiva dal menu Luce notturna. Elimina tutta la luce blu e verde e aiuta "
"ad addormentarsi."

#: src/prefs.js:199
msgid "Only while Night Light is active"
msgstr "Solo mentre la Luce notturna è attiva"

#: src/prefs.js:200
msgid "Starts and stops together with Night Light"
msgstr "Inizia e finisce con la Luce notturna"

#: src/prefs.js:201 src/lib/ui.js:439
msgid "Strength"
msgstr "Intensità"

#: src/prefs.js:215
msgid "Advanced"
msgstr "Avanzate"

#: src/prefs.js:219
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"I monitor esterni sono controllati via DDC/CI. L’utente deve poter accedere "
"a /dev/i2c-* (di solito il gruppo «i2c»)."

#: src/prefs.js:223
msgid "ddcutil found"
msgstr "ddcutil trovato"

#: src/prefs.js:223
msgid "ddcutil not found"
msgstr "ddcutil non trovato"

#: src/prefs.js:224
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "Installa ddcutil dalla tua distribuzione, poi premi Cerca di nuovo"

#: src/prefs.js:226
msgid "Scan again"
msgstr "Cerca di nuovo"

#: src/prefs.js:231
msgid "ddcutil program"
msgstr "Programma ddcutil"

#: src/prefs.js:234
msgid "Extra arguments"
msgstr "Argomenti aggiuntivi"

#: src/prefs.js:237
msgid "Pause between writes"
msgstr "Pausa tra le scritture"

#: src/prefs.js:238
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "Millisecondi. Aumentala se un monitor perde dei cambiamenti"

#: src/prefs.js:242
msgid "Debug messages"
msgstr "Messaggi di debug"

#: src/prefs.js:242
msgid "Written to the system journal"
msgstr "Scritti nel registro di sistema"

#: src/lib/displays.js:37
msgid "Monitor"
msgstr "Monitor"

#: src/lib/displays.js:287
msgid "Built-in Display"
msgstr "Schermo integrato"

#: src/lib/displays.js:288
msgid "Built-in"
msgstr "Integrato"

#: src/lib/displays.js:290
#, javascript-format
msgid "Monitor %d"
msgstr "Monitor %d"

#: src/lib/ui.js:119
msgid "Earlier"
msgstr "Prima"

#: src/lib/ui.js:122
msgid "Later"
msgstr "Dopo"

#: src/lib/ui.js:165
msgid "Evening dimming and more"
msgstr "Attenuazione serale e altro"

#: src/lib/ui.js:282
msgid "Extra dimming"
msgstr "Attenuazione extra"

#: src/lib/ui.js:294
msgid "Turn off others"
msgstr "Spegni gli altri"

#: src/lib/ui.js:318
msgid "Off"
msgstr "Disattivata"

#: src/lib/ui.js:335
msgid "Turned off"
msgstr "Spento"

#: src/lib/ui.js:335
#, javascript-format
msgid "Brightness %s"
msgstr "Luminosità %s"

#: src/lib/ui.js:344
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "Tramonto %s %s %d min"

#: src/lib/ui.js:347
msgid "Fixed time"
msgstr "Orario fisso"

#: src/lib/ui.js:421
msgid "Temperature"
msgstr "Temperatura"

#: src/lib/ui.js:498
msgid "Sunset to sunrise"
msgstr "Dal tramonto all’alba"

#: src/lib/ui.js:514
msgid "Turns on together with Night Light"
msgstr "Si accende con la Luce notturna"

#: src/lib/ui.js:516
msgid "Starts when Night Light starts"
msgstr "Inizia quando inizia la Luce notturna"
