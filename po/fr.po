#: src/prefs.js:75
msgid "General"
msgstr "Général"

#: src/prefs.js:78
msgid "Sliders"
msgstr "Curseurs"

#: src/prefs.js:79
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr ""
"Chaque écran a son propre curseur dans les Réglages rapides, à côté du "
"volume."

#: src/prefs.js:81
msgid "Left of the slider"
msgstr "À gauche du curseur"

#: src/prefs.js:82
msgid "Brightness icon"
msgstr "Icône de luminosité"

#: src/prefs.js:83
msgid "Monitor number (1, 2, 3…)"
msgstr "Numéro d’écran (1, 2, 3…)"

#: src/prefs.js:84
msgid "Short name (LG, VS…)"
msgstr "Nom court (LG, VS…)"

#: src/prefs.js:86
msgid "Show the monitor name on hover"
msgstr "Afficher le nom de l’écran au survol"

#: src/prefs.js:87
msgid "Replace GNOME’s own brightness slider"
msgstr "Remplacer le curseur de luminosité de GNOME"

#: src/prefs.js:88
msgid "The laptop screen then gets a row like the other monitors"
msgstr "L’écran du portable a alors sa ligne comme les autres écrans"

#: src/prefs.js:91
msgid "Night Light"
msgstr "Éclairage nocturne"

#: src/prefs.js:92
msgid "Add a menu to the Night Light button"
msgstr "Ajouter un menu au bouton Éclairage nocturne"

#: src/prefs.js:93
msgid "Temperature, red screen and its strength"
msgstr "Température, écran rouge et son intensité"

#: src/prefs.js:99
msgid "Evening"
msgstr "Soir"

#: src/prefs.js:102 src/lib/ui.js:257
msgid "Evening dimming"
msgstr "Atténuation du soir"

#: src/prefs.js:103
msgid ""
"Turn it on per monitor with the moon button next to its slider. Brightness "
"goes down slowly in the evening and comes back in the morning."
msgstr ""
"Activez-la par écran avec le bouton lune à côté de son curseur. La "
"luminosité baisse doucement le soir et revient le matin."

#: src/prefs.js:105 src/lib/ui.js:264
msgid "Start"
msgstr "Début"

#: src/prefs.js:106
msgid "At sunset"
msgstr "Au coucher du soleil"

#: src/prefs.js:107
msgid "At a fixed time"
msgstr "À heure fixe"

#: src/prefs.js:109
msgid "Transition"
msgstr "Transition"

#: src/prefs.js:109
msgid "Minutes, for both evening and morning"
msgstr "Minutes, pour le soir et le matin"

#: src/prefs.js:110 src/prefs.js:111
msgid "Morning"
msgstr "Matin"

#: src/prefs.js:110
msgid "Minutes after sunrise"
msgstr "Minutes après le lever du soleil"

#: src/prefs.js:111
msgid "Brightness comes back at"
msgstr "La luminosité revient à"

#: src/prefs.js:117
msgid "For new monitors"
msgstr "Pour les nouveaux écrans"

#: src/prefs.js:118
msgid "Each monitor can change these in its own menu."
msgstr "Chaque écran peut les modifier dans son propre menu."

#: src/prefs.js:120
msgid "Minutes after sunset"
msgstr "Minutes après le coucher du soleil"

#: src/prefs.js:121
msgid "Start time"
msgstr "Heure de début"

#: src/prefs.js:125 src/lib/ui.js:269
msgid "Night brightness"
msgstr "Luminosité de nuit"

#: src/prefs.js:125
msgid "Percent"
msgstr "Pourcentage"

#: src/prefs.js:134 src/prefs.js:137
msgid "Location"
msgstr "Position"

#: src/prefs.js:135
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"Sert uniquement à calculer le coucher et le lever du soleil. Automatique "
"utilise la position que GNOME garde pour l’éclairage nocturne, sinon votre "
"fuseau horaire. Rien n’est envoyé."

#: src/prefs.js:138
msgid "Automatic"
msgstr "Automatique"

#: src/prefs.js:139
msgid "Manual"
msgstr "Manuelle"

#: src/prefs.js:141
msgid "Latitude"
msgstr "Latitude"

#: src/prefs.js:142
msgid "Longitude"
msgstr "Longitude"

#: src/prefs.js:145
msgid "Today"
msgstr "Aujourd’hui"

#: src/prefs.js:162
msgid "manual"
msgstr "manuelle"

#: src/prefs.js:163
msgid "GNOME location"
msgstr "position GNOME"

#: src/prefs.js:164
#, javascript-format
msgid "time zone %s"
msgstr "fuseau horaire %s"

#: src/prefs.js:165
msgid "UTC offset"
msgstr "décalage UTC"

#: src/prefs.js:168
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "Coucher %s · lever %s · d’après %s"

#: src/prefs.js:176
msgid "Screen off"
msgstr "Extinction"

#: src/prefs.js:179 src/lib/ui.js:293
msgid "Turn off screen"
msgstr "Éteindre l’écran"

#: src/prefs.js:180
msgid "“Turn off screen” and “Turn off others” in each monitor’s menu."
msgstr ""
"« Éteindre l’écran » et « Éteindre les autres » dans le menu de chaque écran."

#: src/prefs.js:182
msgid "Turned off screen"
msgstr "Écran éteint"

#: src/prefs.js:183
msgid "Fully black"
msgstr "Entièrement noir"

#: src/prefs.js:184
msgid "Lowest light"
msgstr "Lumière minimale"

#: src/prefs.js:186
msgid "Light left"
msgstr "Lumière restante"

#: src/prefs.js:186
msgid "Percent, for “Lowest light”"
msgstr "Pourcentage, pour « Lumière minimale »"

#: src/prefs.js:188
msgid "Turn back on when the mouse comes"
msgstr "Rallumer quand la souris arrive"

#: src/prefs.js:189
msgid "Moving the mouse onto a turned off screen brings its light back"
msgstr "Amener la souris sur un écran éteint lui rend sa lumière"

#: src/prefs.js:196 src/lib/ui.js:429 src/lib/ui.js:490
msgid "Red screen"
msgstr "Écran rouge"

#: src/prefs.js:197
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr ""
"À activer dans le menu Éclairage nocturne. Supprime toute la lumière bleue "
"et verte et aide à s’endormir."

#: src/prefs.js:199
msgid "Only while Night Light is active"
msgstr "Seulement quand l’éclairage nocturne est actif"

#: src/prefs.js:200
msgid "Starts and stops together with Night Light"
msgstr "Démarre et s’arrête avec l’éclairage nocturne"

#: src/prefs.js:201 src/lib/ui.js:439
msgid "Strength"
msgstr "Intensité"

#: src/prefs.js:215
msgid "Advanced"
msgstr "Avancé"

#: src/prefs.js:219
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"Les écrans externes sont pilotés par DDC/CI. Votre utilisateur doit avoir "
"accès à /dev/i2c-* (souvent le groupe « i2c »)."

#: src/prefs.js:223
msgid "ddcutil found"
msgstr "ddcutil trouvé"

#: src/prefs.js:223
msgid "ddcutil not found"
msgstr "ddcutil introuvable"

#: src/prefs.js:224
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr ""
"Installez ddcutil depuis votre distribution, puis cliquez sur Rechercher à "
"nouveau"

#: src/prefs.js:226
msgid "Scan again"
msgstr "Rechercher à nouveau"

#: src/prefs.js:231
msgid "ddcutil program"
msgstr "Programme ddcutil"

#: src/prefs.js:234
msgid "Extra arguments"
msgstr "Arguments supplémentaires"

#: src/prefs.js:237
msgid "Pause between writes"
msgstr "Pause entre les écritures"

#: src/prefs.js:238
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "Millisecondes. À augmenter si un écran rate des changements"

#: src/prefs.js:242
msgid "Debug messages"
msgstr "Messages de débogage"

#: src/prefs.js:242
msgid "Written to the system journal"
msgstr "Écrits dans le journal système"

#: src/lib/displays.js:37
msgid "Monitor"
msgstr "Écran"

#: src/lib/displays.js:287
msgid "Built-in Display"
msgstr "Écran intégré"

#: src/lib/displays.js:288
msgid "Built-in"
msgstr "Intégré"

#: src/lib/displays.js:290
#, javascript-format
msgid "Monitor %d"
msgstr "Écran %d"

#: src/lib/ui.js:119
msgid "Earlier"
msgstr "Plus tôt"

#: src/lib/ui.js:122
msgid "Later"
msgstr "Plus tard"

#: src/lib/ui.js:165
msgid "Evening dimming and more"
msgstr "Atténuation du soir et plus"

#: src/lib/ui.js:282
msgid "Extra dimming"
msgstr "Atténuation supplémentaire"

#: src/lib/ui.js:294
msgid "Turn off others"
msgstr "Éteindre les autres"

#: src/lib/ui.js:318
msgid "Off"
msgstr "Désactivée"

#: src/lib/ui.js:335
msgid "Turned off"
msgstr "Éteint"

#: src/lib/ui.js:335
#, javascript-format
msgid "Brightness %s"
msgstr "Luminosité %s"

#: src/lib/ui.js:344
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "Coucher %s %s %d min"

#: src/lib/ui.js:347
msgid "Fixed time"
msgstr "Heure fixe"

#: src/lib/ui.js:421
msgid "Temperature"
msgstr "Température"

#: src/lib/ui.js:498
msgid "Sunset to sunrise"
msgstr "Du coucher au lever du soleil"

#: src/lib/ui.js:514
msgid "Turns on together with Night Light"
msgstr "S’active avec l’éclairage nocturne"

#: src/lib/ui.js:516
msgid "Starts when Night Light starts"
msgstr "Démarre avec l’éclairage nocturne"
