#: src/prefs.js:62 src/prefs.js:94
msgid "None"
msgstr "Nenhum"

#: src/prefs.js:91
msgid "Press the keys…"
msgstr "Pressione as teclas…"

#: src/prefs.js:127
msgid "General"
msgstr "Geral"

#: src/prefs.js:130
msgid "Claude Code"
msgstr "Claude Code"

#: src/prefs.js:131
msgid "Connect to Claude Code"
msgstr "Conectar ao Claude Code"

#: src/prefs.js:132
msgid ""
"When Claude is done or asks you something, you get a notification and its "
"turned off screen lights up. No account needed."
msgstr ""
"Quando o Claude termina ou te pergunta algo, chega uma notificação e a tela "
"desligada dele acende. Não precisa de conta."

#: src/prefs.js:137
msgid "Connected"
msgstr "Conectado"

#: src/prefs.js:137
msgid "Not connected"
msgstr "Não conectado"

#: src/prefs.js:138
msgid "Disconnect"
msgstr "Desconectar"

#: src/prefs.js:138
msgid "Connect"
msgstr "Conectar"

#: src/prefs.js:149
#, javascript-format
msgid "Could not change %s: %s"
msgstr "Não foi possível alterar %s: %s"

#: src/prefs.js:154
msgid "When Claude is done"
msgstr "Quando o Claude termina"

#: src/prefs.js:155
msgid "When Claude waits for you"
msgstr "Quando o Claude espera por você"

#: src/prefs.js:155
msgid "A permission or a question"
msgstr "Uma permissão ou uma pergunta"

#: src/prefs.js:156
msgid "Also a notification"
msgstr "Também uma notificação"

#: src/prefs.js:156
msgid "Click it to go to the terminal"
msgstr "Clique para ir ao terminal"

#: src/prefs.js:157
msgid "Other programs too"
msgstr "Outros programas também"

#: src/prefs.js:158
msgid ""
"Terminal bell or an app asking for attention, e.g. make ; printf \"\\a\""
msgstr ""
"Campainha do terminal ou um app pedindo atenção, ex. make ; printf \"\\a\""

#: src/prefs.js:163
msgid "Sliders"
msgstr "Controles deslizantes"

#: src/prefs.js:164
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr ""
"Cada monitor ganha seu próprio controle nas Configurações rápidas, ao lado "
"do volume."

#: src/prefs.js:166
msgid "Monitor menu"
msgstr "Menu do monitor"

#: src/prefs.js:167
msgid "Simple (recommended)"
msgstr "Simples (recomendado)"

#: src/prefs.js:168
msgid "Detailed"
msgstr "Detalhado"

#: src/prefs.js:169
msgid ""
"Simple: one slider for the value you pick. Detailed: a slider for every "
"value."
msgstr ""
"Simples: um controle para o valor escolhido. Detalhado: um controle para "
"cada valor."

#: src/prefs.js:170
msgid "Left of the slider"
msgstr "À esquerda do controle"

#: src/prefs.js:171
msgid "Brightness icon"
msgstr "Ícone de brilho"

#: src/prefs.js:172
msgid "Monitor number (1, 2, 3…)"
msgstr "Número do monitor (1, 2, 3…)"

#: src/prefs.js:173
msgid "Short name (LG, VS…)"
msgstr "Nome curto (LG, VS…)"

#: src/prefs.js:175
msgid "Show the monitor name on hover"
msgstr "Mostrar o nome do monitor ao passar o mouse"

#: src/prefs.js:176
msgid "Replace GNOME’s own brightness slider"
msgstr "Substituir o controle de brilho do GNOME"

#: src/prefs.js:177
msgid "The laptop screen then gets a row like the other monitors"
msgstr "A tela do notebook ganha uma linha como os outros monitores"

#: src/prefs.js:180
msgid "Night Light"
msgstr "Luz noturna"

#: src/prefs.js:181
msgid "Add a menu to the Night Light button"
msgstr "Adicionar um menu ao botão Luz noturna"

#: src/prefs.js:182
msgid "Temperature, red screen and its strength"
msgstr "Temperatura, tela vermelha e sua intensidade"

#: src/prefs.js:188
msgid "Evening"
msgstr "Noite"

#: src/prefs.js:191 src/lib/ui.js:1287
msgid "Automatic dimming"
msgstr "Escurecimento automático"

#: src/prefs.js:192
msgid ""
"Turn it on per monitor with the moon button next to its slider. The monitor "
"slowly gets darker and warmer in the evening and comes back in the morning."
msgstr ""
"Ative em cada monitor com o botão de lua ao lado do controle. O monitor fica "
"aos poucos mais escuro e mais quente à noite e volta pela manhã."

#: src/prefs.js:194 src/lib/ui.js:1305
msgid "Start"
msgstr "Início"

#: src/prefs.js:195
msgid "At sunset"
msgstr "No pôr do sol"

#: src/prefs.js:196
msgid "At a fixed time"
msgstr "Em um horário fixo"

#: src/prefs.js:198
msgid "Morning transition"
msgstr "Transição da manhã"

#: src/prefs.js:198
msgid "Minutes"
msgstr "Minutos"

#: src/prefs.js:199 src/prefs.js:200
msgid "Morning"
msgstr "Manhã"

#: src/prefs.js:199
msgid "Minutes after sunrise"
msgstr "Minutos após o nascer do sol"

#: src/prefs.js:200
msgid "Brightness comes back at"
msgstr "O brilho volta às"

#: src/prefs.js:206
msgid "For new monitors"
msgstr "Para monitores novos"

#: src/prefs.js:207
msgid ""
"For the main monitor. The others take 30 minutes longer and go down to 0 %, "
"with a little extra dimming late at night. Each monitor can change these in "
"its own menu."
msgstr ""
"Para o monitor principal. Os outros levam 30 minutos a mais e vão até 0 %, "
"com um pouco de escurecimento extra tarde da noite. Cada monitor pode mudar "
"isso no próprio menu."

#: src/prefs.js:209
msgid "Minutes after sunset"
msgstr "Minutos após o pôr do sol"

#: src/prefs.js:210
msgid "Start time"
msgstr "Horário de início"

#: src/prefs.js:213 src/lib/ui.js:1310
msgid "Duration"
msgstr "Duração"

#: src/prefs.js:213
msgid "Minutes the evening dimming takes"
msgstr "Minutos que o escurecimento noturno leva"

#: src/prefs.js:215 src/lib/ui.js:37
msgid "Night brightness"
msgstr "Brilho noturno"

#: src/prefs.js:215
msgid "Percent"
msgstr "Porcentagem"

#: src/prefs.js:224 src/prefs.js:227
msgid "Location"
msgstr "Localização"

#: src/prefs.js:225
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"Usada só para calcular o pôr e o nascer do sol. Automático usa a localização "
"que o GNOME guarda para a Luz noturna, senão o seu fuso horário. Nada é "
"enviado."

#: src/prefs.js:228
msgid "Automatic"
msgstr "Automático"

#: src/prefs.js:229
msgid "Manual"
msgstr "Manual"

#: src/prefs.js:231
msgid "Latitude"
msgstr "Latitude"

#: src/prefs.js:232
msgid "Longitude"
msgstr "Longitude"

#: src/prefs.js:235
msgid "Today"
msgstr "Hoje"

#: src/prefs.js:252
msgid "manual"
msgstr "manual"

#: src/prefs.js:253
msgid "GNOME location"
msgstr "localização do GNOME"

#: src/prefs.js:254
#, javascript-format
msgid "time zone %s"
msgstr "fuso horário %s"

#: src/prefs.js:255
msgid "UTC offset"
msgstr "diferença UTC"

#: src/prefs.js:258
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "Pôr do sol %s · nascer do sol %s · de %s"

#: src/prefs.js:266
msgid "Screen off"
msgstr "Desligar"

#: src/prefs.js:269
msgid "Buttons"
msgstr "Botões"

#: src/prefs.js:270
msgid "In each monitor’s menu (the moon button)."
msgstr "No menu de cada monitor (botão de lua)."

#: src/prefs.js:272
msgid "Place"
msgstr "Local"

#: src/prefs.js:273
msgid "At the bottom, large"
msgstr "Embaixo, grandes"

#: src/prefs.js:274
msgid "At the top, large"
msgstr "Em cima, grandes"

#: src/prefs.js:275
msgid "Next to the monitor name, small"
msgstr "Ao lado do nome do monitor, pequenos"

#: src/prefs.js:277 src/lib/ui.js:339 src/lib/ui.js:1620 src/lib/ui.js:1691
msgid "Lowest light"
msgstr "Luz mínima"

#: src/prefs.js:278
msgid "Brightness 0 and full extra dimming; press again to go back"
msgstr "Brilho 0 e escurecimento extra total; pressione de novo para voltar"

#: src/prefs.js:279 src/prefs.js:285 src/lib/offmenu.js:48 src/lib/ui.js:340
#: src/lib/ui.js:1623
msgid "Turn off screen"
msgstr "Desligar tela"

#: src/prefs.js:280 src/lib/offmenu.js:49 src/lib/ui.js:341 src/lib/ui.js:1634
msgid "Turn off other screens"
msgstr "Desligar as outras telas"

#: src/prefs.js:281
msgid "Press again to turn them back on"
msgstr "Pressione de novo para ligá-los"

#: src/prefs.js:286
msgid "“Turn off screen” and “Turn off other screens” in each monitor’s menu."
msgstr "“Desligar tela” e “Desligar as outras telas” no menu de cada monitor."

#: src/prefs.js:288
msgid "Light up while the mouse is on it"
msgstr "Acender enquanto o mouse estiver em cima"

#: src/prefs.js:289
msgid ""
"A turned off screen lights up while the mouse is on it and goes dark again "
"when the mouse leaves. The same button turns it back on."
msgstr ""
"Uma tela desligada acende enquanto o mouse está em cima e escurece de novo "
"quando ele sai. O mesmo botão a liga de volta."

#: src/prefs.js:294
msgid "A turned off screen"
msgstr "Uma tela desligada"

#: src/prefs.js:295
msgid ""
"Clicks and typing always reach the apps on it. Its options are in the "
"monitor’s menu (the moon button) and behind the small dot."
msgstr ""
"Cliques e digitação sempre chegam aos apps dela. As opções estão no menu do "
"monitor (botão de lua) e no pequeno ponto."

#: src/prefs.js:297
msgid "Small dot in a corner"
msgstr "Pequeno ponto num canto"

#: src/prefs.js:298
msgid "Click it for the screen’s menu; drag it to another corner"
msgstr "Clique: menu da tela; arraste: para outro canto"

#: src/prefs.js:299
msgid "Keyboard shortcut"
msgstr "Atalho de teclado"

#: src/prefs.js:300
msgid "The menu of the screen under the mouse"
msgstr "O menu da tela sob o mouse"

#: src/prefs.js:301
msgid "“Keep lit” lasts"
msgstr "Duração de “Manter acesa”"

#: src/prefs.js:301
msgid "Seconds"
msgstr "Segundos"

#: src/prefs.js:305 src/lib/ui.js:1836 src/lib/ui.js:1911
msgid "Red screen"
msgstr "Tela vermelha"

#: src/prefs.js:306
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr ""
"Ative no menu Luz noturna. Remove toda a luz azul e verde e ajuda a dormir."

#: src/prefs.js:308
msgid "Only while Night Light is active"
msgstr "Só enquanto a Luz noturna estiver ativa"

#: src/prefs.js:309
msgid "Starts and stops together with Night Light"
msgstr "Começa e termina junto com a Luz noturna"

#: src/prefs.js:310 src/lib/ui.js:1852
msgid "Strength"
msgstr "Intensidade"

#: src/prefs.js:324
msgid "Advanced"
msgstr "Avançado"

#: src/prefs.js:328
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"Monitores externos são controlados por DDC/CI. Seu usuário precisa de acesso "
"a /dev/i2c-* (normalmente o grupo “i2c”)."

#: src/prefs.js:332
msgid "ddcutil found"
msgstr "ddcutil encontrado"

#: src/prefs.js:332
msgid "ddcutil not found"
msgstr "ddcutil não encontrado"

#: src/prefs.js:333
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "Instale o ddcutil da sua distribuição e clique em Procurar novamente"

#: src/prefs.js:335
msgid "Scan again"
msgstr "Procurar novamente"

#: src/prefs.js:340
msgid "ddcutil program"
msgstr "Programa ddcutil"

#: src/prefs.js:343
msgid "Extra arguments"
msgstr "Argumentos extras"

#: src/prefs.js:346
msgid "Pause between writes"
msgstr "Pausa entre gravações"

#: src/prefs.js:347
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "Milissegundos. Aumente se um monitor perder mudanças"

#: src/prefs.js:351
msgid "Debug messages"
msgstr "Mensagens de depuração"

#: src/prefs.js:351
msgid "Written to the system journal"
msgstr "Gravadas no diário do sistema"

#: src/lib/cornerdot.js:61
msgid "Screen menu"
msgstr "Menu da tela"

#: src/lib/displays.js:59
msgid "Monitor"
msgstr "Monitor"

#: src/lib/displays.js:415
msgid "Built-in Display"
msgstr "Tela embutida"

#: src/lib/displays.js:416
msgid "Built-in"
msgstr "Embutida"

#: src/lib/displays.js:418
#, javascript-format
msgid "Monitor %d"
msgstr "Monitor %d"

#: src/lib/notify.js:115
msgid "Claude is waiting for you"
msgstr "O Claude está esperando por você"

#: src/lib/notify.js:115
msgid "Claude is done"
msgstr "O Claude terminou"

#: src/lib/notify.js:129
msgid "Go to the terminal"
msgstr "Ir para o terminal"

#: src/lib/offmenu.js:15
#, javascript-format
msgid "%d s"
msgstr "%d s"

#: src/lib/offmenu.js:17
#, javascript-format
msgid "%d min %d s"
msgstr "%d min %d s"

#: src/lib/offmenu.js:17 src/lib/ui.js:62
#, javascript-format
msgid "%d min"
msgstr "%d min"

#: src/lib/offmenu.js:43
#, javascript-format
msgid "Keep lit · %s"
msgstr "Manter acesa · %s"

#: src/lib/offmenu.js:44
msgid "Keep lit until I darken it"
msgstr "Manter acesa até eu escurecer"

#: src/lib/offmenu.js:45
msgid "Darken now"
msgstr "Escurecer agora"

#: src/lib/offmenu.js:46
msgid "Turn the screen back on"
msgstr "Ligar a tela de volta"

#: src/lib/ui.js:36
msgid "Day brightness"
msgstr "Brilho de dia"

#: src/lib/ui.js:38
msgid "Extra dimming"
msgstr "Escurecimento extra"

#: src/lib/ui.js:39
msgid ""
"Darkens the picture further when the monitor is already at its lowest "
"brightness."
msgstr ""
"Escurece ainda mais a imagem quando o monitor já está no brilho mínimo."

#: src/lib/ui.js:45
msgid "Night light"
msgstr "Luz noturna"

#: src/lib/ui.js:46 src/lib/ui.js:1824
msgid ""
"Blue light in the evening holds back melatonin, the sleep hormone. A warmer "
"screen helps you fall asleep more easily."
msgstr ""
"À noite, a luz azul freia a melatonina, o hormônio do sono. Uma tela mais "
"quente ajuda você a adormecer com mais facilidade."

#: src/lib/ui.js:47
msgid ""
"How strong Night Light is on this monitor. ×1 = exactly GNOME’s Night Light, "
"nothing added. ×0 turns it off here, ×2 makes it twice as warm."
msgstr ""
"Intensidade da luz noturna neste monitor. ×1 = exatamente a luz noturna do "
"GNOME, nada a mais. ×0 desliga aqui, ×2 deixa duas vezes mais quente."

#: src/lib/ui.js:48
msgid "Red light"
msgstr "Luz vermelha"

#: src/lib/ui.js:49 src/lib/ui.js:1841
msgid ""
"Red light disturbs melatonin and your body clock the least of all colours. "
"Ideal for the last hours before bed."
msgstr ""
"A luz vermelha é a cor que menos afeta a melatonina e o relógio biológico. "
"Ideal para as últimas horas antes de dormir."

#: src/lib/ui.js:50
msgid ""
"How strong the red screen is on this monitor. ×1 = the red screen as set in "
"the Night Light menu, nothing added. ×0 keeps this monitor normal, ×2 makes "
"it twice as red."
msgstr ""
"Intensidade da tela vermelha neste monitor. ×1 = a tela vermelha como no "
"menu da luz noturna, nada a mais. ×0 deixa normal, ×2 deixa duas vezes mais "
"vermelho."

#: src/lib/ui.js:63
#, javascript-format
msgid "%d h %d min"
msgstr "%d h %d min"

#: src/lib/ui.js:63
#, javascript-format
msgid "%d h"
msgstr "%d h"

#: src/lib/ui.js:284
msgid "Earlier"
msgstr "Mais cedo"

#: src/lib/ui.js:287
msgid "Later"
msgstr "Mais tarde"

#: src/lib/ui.js:1080
msgid "Automatic dimming and more"
msgstr "Escurecimento automático e mais"

#: src/lib/ui.js:1249
msgid "Settings"
msgstr "Configurações"

#: src/lib/ui.js:1293
msgid ""
"Slowly dims this monitor in the evening, and brings it back in the morning."
msgstr "Escurece este monitor aos poucos à noite e o traz de volta pela manhã."

#: src/lib/ui.js:1294
msgid ""
"Drag the points to shape the evening; the big point also sets how long it "
"takes. + adds a button that runs by itself."
msgstr ""
"Arraste os pontos para moldar a noite; o ponto grande também define quanto "
"dura. + adiciona um botão que funciona sozinho."

#: src/lib/ui.js:1311
msgid "Shorter"
msgstr "Mais curto"

#: src/lib/ui.js:1312
msgid "Longer"
msgstr "Mais longo"

#: src/lib/ui.js:1322
msgid "Back to normal in the morning"
msgstr "Voltar ao normal de manhã"

#: src/lib/ui.js:1326
msgid ""
"When the morning comes, lowest light and turned off screens go back to "
"normal, whether they were switched on by hand or by the graph."
msgstr ""
"De manhã, a luz mínima e as telas desligadas voltam ao normal, tenham sido "
"ativadas à mão ou pelo gráfico."

#: src/lib/ui.js:1359
msgid "Back to 100 %"
msgstr "Voltar a 100 %"

#: src/lib/ui.js:1362 src/lib/ui.js:1364
msgid "Back to the default evening curve"
msgstr "Voltar à curva noturna padrão"

#: src/lib/ui.js:1380
msgid "Back to the default: ×1 and GNOME’s automatic time (sunset)"
msgstr "Voltar ao padrão: ×1 e o horário automático do GNOME (pôr do sol)"

#: src/lib/ui.js:1385
msgid "Back to ×1"
msgstr "Voltar a ×1"

#: src/lib/ui.js:1403
msgid "Day"
msgstr "Dia"

#: src/lib/ui.js:1403
msgid "Night"
msgstr "Noite"

#: src/lib/ui.js:1403
msgid "Extra"
msgstr "Extra"

#: src/lib/ui.js:1404
msgid "Warmth"
msgstr "Calor"

#: src/lib/ui.js:1404
msgid "Red"
msgstr "Vermelho"

#: src/lib/ui.js:1436 src/lib/ui.js:1585 src/lib/ui.js:1854
msgid "Back to the default"
msgstr "Voltar ao padrão"

#: src/lib/ui.js:1541
msgid "While the screen is off"
msgstr "Enquanto a tela está desligada"

#: src/lib/ui.js:1581
msgid "Dark while off"
msgstr "Escuro enquanto desligada"

#: src/lib/ui.js:1582
msgid ""
"While the screen is off, the monitor stays at its lowest light and this much "
"black is added on top. 25 % = a little darker, 100 % = fully black."
msgstr ""
"Enquanto a tela está desligada, o monitor fica na luz mínima e este tanto de "
"preto é adicionado por cima. 25 % = um pouco mais escuro, 100 % = preto "
"total."

#: src/lib/ui.js:1602
#, javascript-format
msgid "Keep lit for %s"
msgstr "Manter acesa %s"

#: src/lib/ui.js:1603
#, javascript-format
msgid ""
"On: after the mouse leaves, the screen stays lit for %s, then goes dark. "
"Off: it goes dark as soon as the mouse leaves."
msgstr ""
"Ligado: quando o mouse sai, a tela fica acesa por mais %s e depois escurece. "
"Desligado: escurece assim que o mouse sai."

#: src/lib/ui.js:1687
#, javascript-format
msgid "Brightness %s"
msgstr "Brilho %s"

#: src/lib/ui.js:1689
msgid "Turned off"
msgstr "Desligada"

#: src/lib/ui.js:1709
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "Pôr do sol %s %s %d min"

#: src/lib/ui.js:1712
msgid "Fixed time"
msgstr "Horário fixo"

#: src/lib/ui.js:1715
#, javascript-format
msgid "Until %s"
msgstr "Até %s"

#: src/lib/ui.js:1724
msgid "Off"
msgstr "Desligado"

#: src/lib/ui.js:1822
msgid "Temperature"
msgstr "Temperatura"

#: src/lib/ui.js:1825
msgid "Back to GNOME’s default"
msgstr "Voltar ao padrão do GNOME"

#: src/lib/ui.js:1919
msgid "Sunset to sunrise"
msgstr "Do pôr ao nascer do sol"

#: src/lib/ui.js:1941
msgid "Turns on together with Night Light"
msgstr "Liga junto com a Luz noturna"

#: src/lib/ui.js:1943
msgid "Starts when Night Light starts"
msgstr "Começa quando a Luz noturna começa"
