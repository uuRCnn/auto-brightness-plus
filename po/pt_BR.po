#: src/prefs.js:75
msgid "General"
msgstr "Geral"

#: src/prefs.js:78
msgid "Sliders"
msgstr "Controles deslizantes"

#: src/prefs.js:79
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr ""
"Cada monitor ganha seu próprio controle nas Configurações rápidas, ao lado "
"do volume."

#: src/prefs.js:81
msgid "Left of the slider"
msgstr "À esquerda do controle"

#: src/prefs.js:82
msgid "Brightness icon"
msgstr "Ícone de brilho"

#: src/prefs.js:83
msgid "Monitor number (1, 2, 3…)"
msgstr "Número do monitor (1, 2, 3…)"

#: src/prefs.js:84
msgid "Short name (LG, VS…)"
msgstr "Nome curto (LG, VS…)"

#: src/prefs.js:86
msgid "Show the monitor name on hover"
msgstr "Mostrar o nome do monitor ao passar o mouse"

#: src/prefs.js:87
msgid "Replace GNOME’s own brightness slider"
msgstr "Substituir o controle de brilho do GNOME"

#: src/prefs.js:88
msgid "The laptop screen then gets a row like the other monitors"
msgstr "A tela do notebook ganha uma linha como os outros monitores"

#: src/prefs.js:91
msgid "Night Light"
msgstr "Luz noturna"

#: src/prefs.js:92
msgid "Add a menu to the Night Light button"
msgstr "Adicionar um menu ao botão Luz noturna"

#: src/prefs.js:93
msgid "Temperature, red screen and its strength"
msgstr "Temperatura, tela vermelha e sua intensidade"

#: src/prefs.js:99
msgid "Evening"
msgstr "Noite"

#: src/prefs.js:102 src/lib/ui.js:257
msgid "Evening dimming"
msgstr "Escurecimento noturno"

#: src/prefs.js:103
msgid ""
"Turn it on per monitor with the moon button next to its slider. Brightness "
"goes down slowly in the evening and comes back in the morning."
msgstr ""
"Ative por monitor com o botão de lua ao lado do controle. O brilho baixa "
"devagar à noite e volta de manhã."

#: src/prefs.js:105 src/lib/ui.js:264
msgid "Start"
msgstr "Início"

#: src/prefs.js:106
msgid "At sunset"
msgstr "No pôr do sol"

#: src/prefs.js:107
msgid "At a fixed time"
msgstr "Em um horário fixo"

#: src/prefs.js:109
msgid "Transition"
msgstr "Transição"

#: src/prefs.js:109
msgid "Minutes, for both evening and morning"
msgstr "Minutos, para a noite e a manhã"

#: src/prefs.js:110 src/prefs.js:111
msgid "Morning"
msgstr "Manhã"

#: src/prefs.js:110
msgid "Minutes after sunrise"
msgstr "Minutos após o nascer do sol"

#: src/prefs.js:111
msgid "Brightness comes back at"
msgstr "O brilho volta às"

#: src/prefs.js:117
msgid "For new monitors"
msgstr "Para monitores novos"

#: src/prefs.js:118
msgid "Each monitor can change these in its own menu."
msgstr "Cada monitor pode mudar isso no próprio menu."

#: src/prefs.js:120
msgid "Minutes after sunset"
msgstr "Minutos após o pôr do sol"

#: src/prefs.js:121
msgid "Start time"
msgstr "Horário de início"

#: src/prefs.js:125 src/lib/ui.js:269
msgid "Night brightness"
msgstr "Brilho noturno"

#: src/prefs.js:125
msgid "Percent"
msgstr "Porcentagem"

#: src/prefs.js:134 src/prefs.js:137
msgid "Location"
msgstr "Localização"

#: src/prefs.js:135
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"Usada só para calcular o pôr e o nascer do sol. Automático usa a localização "
"que o GNOME guarda para a Luz noturna, senão o seu fuso horário. Nada é "
"enviado."

#: src/prefs.js:138
msgid "Automatic"
msgstr "Automático"

#: src/prefs.js:139
msgid "Manual"
msgstr "Manual"

#: src/prefs.js:141
msgid "Latitude"
msgstr "Latitude"

#: src/prefs.js:142
msgid "Longitude"
msgstr "Longitude"

#: src/prefs.js:145
msgid "Today"
msgstr "Hoje"

#: src/prefs.js:162
msgid "manual"
msgstr "manual"

#: src/prefs.js:163
msgid "GNOME location"
msgstr "localização do GNOME"

#: src/prefs.js:164
#, javascript-format
msgid "time zone %s"
msgstr "fuso horário %s"

#: src/prefs.js:165
msgid "UTC offset"
msgstr "diferença UTC"

#: src/prefs.js:168
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "Pôr do sol %s · nascer do sol %s · de %s"

#: src/prefs.js:176
msgid "Screen off"
msgstr "Desligar"

#: src/prefs.js:179 src/lib/ui.js:293
msgid "Turn off screen"
msgstr "Desligar tela"

#: src/prefs.js:180
msgid "“Turn off screen” and “Turn off others” in each monitor’s menu."
msgstr "“Desligar tela” e “Desligar as outras” no menu de cada monitor."

#: src/prefs.js:182
msgid "Turned off screen"
msgstr "Tela desligada"

#: src/prefs.js:183
msgid "Fully black"
msgstr "Totalmente preta"

#: src/prefs.js:184
msgid "Lowest light"
msgstr "Luz mínima"

#: src/prefs.js:186
msgid "Light left"
msgstr "Luz restante"

#: src/prefs.js:186
msgid "Percent, for “Lowest light”"
msgstr "Porcentagem, para “Luz mínima”"

#: src/prefs.js:188
msgid "Turn back on when the mouse comes"
msgstr "Religar quando o mouse chegar"

#: src/prefs.js:189
msgid "Moving the mouse onto a turned off screen brings its light back"
msgstr "Levar o mouse a uma tela desligada devolve a luz dela"

#: src/prefs.js:196 src/lib/ui.js:429 src/lib/ui.js:490
msgid "Red screen"
msgstr "Tela vermelha"

#: src/prefs.js:197
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr ""
"Ative no menu Luz noturna. Remove toda a luz azul e verde e ajuda a dormir."

#: src/prefs.js:199
msgid "Only while Night Light is active"
msgstr "Só enquanto a Luz noturna estiver ativa"

#: src/prefs.js:200
msgid "Starts and stops together with Night Light"
msgstr "Começa e termina junto com a Luz noturna"

#: src/prefs.js:201 src/lib/ui.js:439
msgid "Strength"
msgstr "Intensidade"

#: src/prefs.js:215
msgid "Advanced"
msgstr "Avançado"

#: src/prefs.js:219
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"Monitores externos são controlados por DDC/CI. Seu usuário precisa de acesso "
"a /dev/i2c-* (normalmente o grupo “i2c”)."

#: src/prefs.js:223
msgid "ddcutil found"
msgstr "ddcutil encontrado"

#: src/prefs.js:223
msgid "ddcutil not found"
msgstr "ddcutil não encontrado"

#: src/prefs.js:224
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "Instale o ddcutil da sua distribuição e clique em Procurar novamente"

#: src/prefs.js:226
msgid "Scan again"
msgstr "Procurar novamente"

#: src/prefs.js:231
msgid "ddcutil program"
msgstr "Programa ddcutil"

#: src/prefs.js:234
msgid "Extra arguments"
msgstr "Argumentos extras"

#: src/prefs.js:237
msgid "Pause between writes"
msgstr "Pausa entre gravações"

#: src/prefs.js:238
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "Milissegundos. Aumente se um monitor perder mudanças"

#: src/prefs.js:242
msgid "Debug messages"
msgstr "Mensagens de depuração"

#: src/prefs.js:242
msgid "Written to the system journal"
msgstr "Gravadas no diário do sistema"

#: src/lib/displays.js:37
msgid "Monitor"
msgstr "Monitor"

#: src/lib/displays.js:287
msgid "Built-in Display"
msgstr "Tela embutida"

#: src/lib/displays.js:288
msgid "Built-in"
msgstr "Embutida"

#: src/lib/displays.js:290
#, javascript-format
msgid "Monitor %d"
msgstr "Monitor %d"

#: src/lib/ui.js:119
msgid "Earlier"
msgstr "Mais cedo"

#: src/lib/ui.js:122
msgid "Later"
msgstr "Mais tarde"

#: src/lib/ui.js:165
msgid "Evening dimming and more"
msgstr "Escurecimento noturno e mais"

#: src/lib/ui.js:282
msgid "Extra dimming"
msgstr "Escurecimento extra"

#: src/lib/ui.js:294
msgid "Turn off others"
msgstr "Desligar as outras"

#: src/lib/ui.js:318
msgid "Off"
msgstr "Desligado"

#: src/lib/ui.js:335
msgid "Turned off"
msgstr "Desligada"

#: src/lib/ui.js:335
#, javascript-format
msgid "Brightness %s"
msgstr "Brilho %s"

#: src/lib/ui.js:344
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "Pôr do sol %s %s %d min"

#: src/lib/ui.js:347
msgid "Fixed time"
msgstr "Horário fixo"

#: src/lib/ui.js:421
msgid "Temperature"
msgstr "Temperatura"

#: src/lib/ui.js:498
msgid "Sunset to sunrise"
msgstr "Do pôr ao nascer do sol"

#: src/lib/ui.js:514
msgid "Turns on together with Night Light"
msgstr "Liga junto com a Luz noturna"

#: src/lib/ui.js:516
msgid "Starts when Night Light starts"
msgstr "Começa quando a Luz noturna começa"
