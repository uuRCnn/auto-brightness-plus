#: src/prefs.js:75
msgid "General"
msgstr "Umum"

#: src/prefs.js:78
msgid "Sliders"
msgstr "Penggeser"

#: src/prefs.js:79
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr ""
"Setiap monitor mendapat penggeser sendiri di Pengaturan Cepat, di samping "
"penggeser volume."

#: src/prefs.js:81
msgid "Left of the slider"
msgstr "Di kiri penggeser"

#: src/prefs.js:82
msgid "Brightness icon"
msgstr "Ikon kecerahan"

#: src/prefs.js:83
msgid "Monitor number (1, 2, 3…)"
msgstr "Nomor monitor (1, 2, 3…)"

#: src/prefs.js:84
msgid "Short name (LG, VS…)"
msgstr "Nama pendek (LG, VS…)"

#: src/prefs.js:86
msgid "Show the monitor name on hover"
msgstr "Tampilkan nama monitor saat disorot"

#: src/prefs.js:87
msgid "Replace GNOME’s own brightness slider"
msgstr "Ganti penggeser kecerahan bawaan GNOME"

#: src/prefs.js:88
msgid "The laptop screen then gets a row like the other monitors"
msgstr "Layar laptop lalu mendapat baris seperti monitor lain"

#: src/prefs.js:91
msgid "Night Light"
msgstr "Cahaya Malam"

#: src/prefs.js:92
msgid "Add a menu to the Night Light button"
msgstr "Tambahkan menu ke tombol Cahaya Malam"

#: src/prefs.js:93
msgid "Temperature, red screen and its strength"
msgstr "Suhu warna, layar merah dan kekuatannya"

#: src/prefs.js:99
msgid "Evening"
msgstr "Petang"

#: src/prefs.js:102 src/lib/ui.js:257
msgid "Evening dimming"
msgstr "Peredupan petang"

#: src/prefs.js:103
msgid ""
"Turn it on per monitor with the moon button next to its slider. Brightness "
"goes down slowly in the evening and comes back in the morning."
msgstr ""
"Nyalakan per monitor dengan tombol bulan di samping penggesernya. Kecerahan "
"turun perlahan di petang hari dan kembali di pagi hari."

#: src/prefs.js:105 src/lib/ui.js:264
msgid "Start"
msgstr "Mulai"

#: src/prefs.js:106
msgid "At sunset"
msgstr "Saat matahari terbenam"

#: src/prefs.js:107
msgid "At a fixed time"
msgstr "Pada waktu tetap"

#: src/prefs.js:109
msgid "Transition"
msgstr "Transisi"

#: src/prefs.js:109
msgid "Minutes, for both evening and morning"
msgstr "Menit, untuk petang dan pagi"

#: src/prefs.js:110 src/prefs.js:111
msgid "Morning"
msgstr "Pagi"

#: src/prefs.js:110
msgid "Minutes after sunrise"
msgstr "Menit setelah matahari terbit"

#: src/prefs.js:111
msgid "Brightness comes back at"
msgstr "Kecerahan kembali pada"

#: src/prefs.js:117
msgid "For new monitors"
msgstr "Untuk monitor baru"

#: src/prefs.js:118
msgid "Each monitor can change these in its own menu."
msgstr "Setiap monitor bisa mengubahnya di menunya sendiri."

#: src/prefs.js:120
msgid "Minutes after sunset"
msgstr "Menit setelah matahari terbenam"

#: src/prefs.js:121
msgid "Start time"
msgstr "Waktu mulai"

#: src/prefs.js:125 src/lib/ui.js:269
msgid "Night brightness"
msgstr "Kecerahan malam"

#: src/prefs.js:125
msgid "Percent"
msgstr "Persen"

#: src/prefs.js:134 src/prefs.js:137
msgid "Location"
msgstr "Lokasi"

#: src/prefs.js:135
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"Hanya dipakai untuk menghitung matahari terbenam dan terbit. Otomatis "
"memakai lokasi yang disimpan GNOME untuk Cahaya Malam, atau zona waktu Anda. "
"Tidak ada yang dikirim."

#: src/prefs.js:138
msgid "Automatic"
msgstr "Otomatis"

#: src/prefs.js:139
msgid "Manual"
msgstr "Manual"

#: src/prefs.js:141
msgid "Latitude"
msgstr "Lintang"

#: src/prefs.js:142
msgid "Longitude"
msgstr "Bujur"

#: src/prefs.js:145
msgid "Today"
msgstr "Hari ini"

#: src/prefs.js:162
msgid "manual"
msgstr "manual"

#: src/prefs.js:163
msgid "GNOME location"
msgstr "lokasi GNOME"

#: src/prefs.js:164
#, javascript-format
msgid "time zone %s"
msgstr "zona waktu %s"

#: src/prefs.js:165
msgid "UTC offset"
msgstr "selisih UTC"

#: src/prefs.js:168
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "Terbenam %s · terbit %s · dari %s"

#: src/prefs.js:176
msgid "Screen off"
msgstr "Matikan layar"

#: src/prefs.js:179 src/lib/ui.js:293
msgid "Turn off screen"
msgstr "Matikan layar"

#: src/prefs.js:180
msgid "“Turn off screen” and “Turn off others” in each monitor’s menu."
msgstr "“Matikan layar” dan “Matikan yang lain” di menu tiap monitor."

#: src/prefs.js:182
msgid "Turned off screen"
msgstr "Layar yang dimatikan"

#: src/prefs.js:183
msgid "Fully black"
msgstr "Hitam sepenuhnya"

#: src/prefs.js:184
msgid "Lowest light"
msgstr "Cahaya terendah"

#: src/prefs.js:186
msgid "Light left"
msgstr "Sisa cahaya"

#: src/prefs.js:186
msgid "Percent, for “Lowest light”"
msgstr "Persen, untuk “Cahaya terendah”"

#: src/prefs.js:188
msgid "Turn back on when the mouse comes"
msgstr "Nyalakan lagi saat tetikus datang"

#: src/prefs.js:189
msgid "Moving the mouse onto a turned off screen brings its light back"
msgstr "Menggerakkan tetikus ke layar yang mati mengembalikan cahayanya"

#: src/prefs.js:196 src/lib/ui.js:429 src/lib/ui.js:490
msgid "Red screen"
msgstr "Layar merah"

#: src/prefs.js:197
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr ""
"Nyalakan di menu Cahaya Malam. Menghilangkan semua cahaya biru dan hijau, "
"membantu Anda tidur."

#: src/prefs.js:199
msgid "Only while Night Light is active"
msgstr "Hanya saat Cahaya Malam aktif"

#: src/prefs.js:200
msgid "Starts and stops together with Night Light"
msgstr "Mulai dan berhenti bersama Cahaya Malam"

#: src/prefs.js:201 src/lib/ui.js:439
msgid "Strength"
msgstr "Kekuatan"

#: src/prefs.js:215
msgid "Advanced"
msgstr "Lanjutan"

#: src/prefs.js:219
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"Monitor eksternal dikendalikan lewat DDC/CI. Pengguna perlu akses ke /dev/"
"i2c-* (biasanya grup “i2c”)."

#: src/prefs.js:223
msgid "ddcutil found"
msgstr "ddcutil ditemukan"

#: src/prefs.js:223
msgid "ddcutil not found"
msgstr "ddcutil tidak ditemukan"

#: src/prefs.js:224
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "Pasang ddcutil dari distribusi Anda, lalu tekan Pindai lagi"

#: src/prefs.js:226
msgid "Scan again"
msgstr "Pindai lagi"

#: src/prefs.js:231
msgid "ddcutil program"
msgstr "Program ddcutil"

#: src/prefs.js:234
msgid "Extra arguments"
msgstr "Argumen tambahan"

#: src/prefs.js:237
msgid "Pause between writes"
msgstr "Jeda antar penulisan"

#: src/prefs.js:238
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "Milidetik. Naikkan jika monitor melewatkan perubahan"

#: src/prefs.js:242
msgid "Debug messages"
msgstr "Pesan debug"

#: src/prefs.js:242
msgid "Written to the system journal"
msgstr "Ditulis ke jurnal sistem"

#: src/lib/displays.js:37
msgid "Monitor"
msgstr "Monitor"

#: src/lib/displays.js:287
msgid "Built-in Display"
msgstr "Layar Bawaan"

#: src/lib/displays.js:288
msgid "Built-in"
msgstr "Bawaan"

#: src/lib/displays.js:290
#, javascript-format
msgid "Monitor %d"
msgstr "Monitor %d"

#: src/lib/ui.js:119
msgid "Earlier"
msgstr "Lebih awal"

#: src/lib/ui.js:122
msgid "Later"
msgstr "Lebih lambat"

#: src/lib/ui.js:165
msgid "Evening dimming and more"
msgstr "Peredupan petang dan lainnya"

#: src/lib/ui.js:282
msgid "Extra dimming"
msgstr "Peredupan ekstra"

#: src/lib/ui.js:294
msgid "Turn off others"
msgstr "Matikan yang lain"

#: src/lib/ui.js:318
msgid "Off"
msgstr "Mati"

#: src/lib/ui.js:335
msgid "Turned off"
msgstr "Dimatikan"

#: src/lib/ui.js:335
#, javascript-format
msgid "Brightness %s"
msgstr "Kecerahan %s"

#: src/lib/ui.js:344
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "Terbenam %s %s %d mnt"

#: src/lib/ui.js:347
msgid "Fixed time"
msgstr "Waktu tetap"

#: src/lib/ui.js:421
msgid "Temperature"
msgstr "Suhu warna"

#: src/lib/ui.js:498
msgid "Sunset to sunrise"
msgstr "Terbenam hingga terbit"

#: src/lib/ui.js:514
msgid "Turns on together with Night Light"
msgstr "Menyala bersama Cahaya Malam"

#: src/lib/ui.js:516
msgid "Starts when Night Light starts"
msgstr "Mulai saat Cahaya Malam mulai"
