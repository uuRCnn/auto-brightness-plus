#: src/prefs.js:75
msgid "General"
msgstr "General"

#: src/prefs.js:78
msgid "Sliders"
msgstr "Controles deslizantes"

#: src/prefs.js:79
msgid ""
"Every monitor gets its own slider in Quick Settings, next to the volume "
"slider."
msgstr ""
"Cada monitor tiene su propio control en Ajustes rápidos, junto al de volumen."

#: src/prefs.js:81
msgid "Left of the slider"
msgstr "A la izquierda del control"

#: src/prefs.js:82
msgid "Brightness icon"
msgstr "Icono de brillo"

#: src/prefs.js:83
msgid "Monitor number (1, 2, 3…)"
msgstr "Número de monitor (1, 2, 3…)"

#: src/prefs.js:84
msgid "Short name (LG, VS…)"
msgstr "Nombre corto (LG, VS…)"

#: src/prefs.js:86
msgid "Show the monitor name on hover"
msgstr "Mostrar el nombre del monitor al pasar el ratón"

#: src/prefs.js:87
msgid "Replace GNOME’s own brightness slider"
msgstr "Sustituir el control de brillo de GNOME"

#: src/prefs.js:88
msgid "The laptop screen then gets a row like the other monitors"
msgstr ""
"La pantalla del portátil tendrá su propia fila como los demás monitores"

#: src/prefs.js:91
msgid "Night Light"
msgstr "Luz nocturna"

#: src/prefs.js:92
msgid "Add a menu to the Night Light button"
msgstr "Añadir un menú al botón de Luz nocturna"

#: src/prefs.js:93
msgid "Temperature, red screen and its strength"
msgstr "Temperatura, pantalla roja y su intensidad"

#: src/prefs.js:99
msgid "Evening"
msgstr "Noche"

#: src/prefs.js:102 src/lib/ui.js:257
msgid "Evening dimming"
msgstr "Atenuación nocturna"

#: src/prefs.js:103
msgid ""
"Turn it on per monitor with the moon button next to its slider. Brightness "
"goes down slowly in the evening and comes back in the morning."
msgstr ""
"Actívala en cada monitor con el botón de luna junto a su control. El brillo "
"baja poco a poco por la tarde y vuelve por la mañana."

#: src/prefs.js:105 src/lib/ui.js:264
msgid "Start"
msgstr "Inicio"

#: src/prefs.js:106
msgid "At sunset"
msgstr "Al atardecer"

#: src/prefs.js:107
msgid "At a fixed time"
msgstr "A una hora fija"

#: src/prefs.js:109
msgid "Transition"
msgstr "Transición"

#: src/prefs.js:109
msgid "Minutes, for both evening and morning"
msgstr "Minutos, para la tarde y la mañana"

#: src/prefs.js:110 src/prefs.js:111
msgid "Morning"
msgstr "Mañana"

#: src/prefs.js:110
msgid "Minutes after sunrise"
msgstr "Minutos después del amanecer"

#: src/prefs.js:111
msgid "Brightness comes back at"
msgstr "El brillo vuelve a las"

#: src/prefs.js:117
msgid "For new monitors"
msgstr "Para monitores nuevos"

#: src/prefs.js:118
msgid "Each monitor can change these in its own menu."
msgstr "Cada monitor puede cambiar esto en su propio menú."

#: src/prefs.js:120
msgid "Minutes after sunset"
msgstr "Minutos después del atardecer"

#: src/prefs.js:121
msgid "Start time"
msgstr "Hora de inicio"

#: src/prefs.js:125 src/lib/ui.js:269
msgid "Night brightness"
msgstr "Brillo nocturno"

#: src/prefs.js:125
msgid "Percent"
msgstr "Porcentaje"

#: src/prefs.js:134 src/prefs.js:137
msgid "Location"
msgstr "Ubicación"

#: src/prefs.js:135
msgid ""
"Only used to calculate sunset and sunrise. Automatic uses the location GNOME "
"keeps for Night Light, otherwise your time zone. Nothing is sent anywhere."
msgstr ""
"Solo se usa para calcular el atardecer y el amanecer. Automático usa la "
"ubicación que GNOME guarda para la Luz nocturna; si no, tu zona horaria. No "
"se envía nada a ningún sitio."

#: src/prefs.js:138
msgid "Automatic"
msgstr "Automático"

#: src/prefs.js:139
msgid "Manual"
msgstr "Manual"

#: src/prefs.js:141
msgid "Latitude"
msgstr "Latitud"

#: src/prefs.js:142
msgid "Longitude"
msgstr "Longitud"

#: src/prefs.js:145
msgid "Today"
msgstr "Hoy"

#: src/prefs.js:162
msgid "manual"
msgstr "manual"

#: src/prefs.js:163
msgid "GNOME location"
msgstr "ubicación de GNOME"

#: src/prefs.js:164
#, javascript-format
msgid "time zone %s"
msgstr "zona horaria %s"

#: src/prefs.js:165
msgid "UTC offset"
msgstr "diferencia UTC"

#: src/prefs.js:168
#, javascript-format
msgid "Sunset %s · sunrise %s · from %s"
msgstr "Atardecer %s · amanecer %s · según %s"

#: src/prefs.js:176
msgid "Screen off"
msgstr "Apagado"

#: src/prefs.js:179 src/lib/ui.js:293
msgid "Turn off screen"
msgstr "Apagar pantalla"

#: src/prefs.js:180
msgid "“Turn off screen” and “Turn off others” in each monitor’s menu."
msgstr "«Apagar pantalla» y «Apagar las demás» en el menú de cada monitor."

#: src/prefs.js:182
msgid "Turned off screen"
msgstr "Pantalla apagada"

#: src/prefs.js:183
msgid "Fully black"
msgstr "Totalmente negra"

#: src/prefs.js:184
msgid "Lowest light"
msgstr "Luz mínima"

#: src/prefs.js:186
msgid "Light left"
msgstr "Luz restante"

#: src/prefs.js:186
msgid "Percent, for “Lowest light”"
msgstr "Porcentaje, para «Luz mínima»"

#: src/prefs.js:188
msgid "Turn back on when the mouse comes"
msgstr "Encender al llegar el ratón"

#: src/prefs.js:189
msgid "Moving the mouse onto a turned off screen brings its light back"
msgstr "Mover el ratón a una pantalla apagada le devuelve la luz"

#: src/prefs.js:196 src/lib/ui.js:429 src/lib/ui.js:490
msgid "Red screen"
msgstr "Pantalla roja"

#: src/prefs.js:197
msgid ""
"Switch it on in the Night Light menu. It removes all blue and green light, "
"which helps you fall asleep."
msgstr ""
"Actívala en el menú de Luz nocturna. Elimina toda la luz azul y verde y te "
"ayuda a dormir."

#: src/prefs.js:199
msgid "Only while Night Light is active"
msgstr "Solo mientras la Luz nocturna está activa"

#: src/prefs.js:200
msgid "Starts and stops together with Night Light"
msgstr "Empieza y termina con la Luz nocturna"

#: src/prefs.js:201 src/lib/ui.js:439
msgid "Strength"
msgstr "Intensidad"

#: src/prefs.js:215
msgid "Advanced"
msgstr "Avanzado"

#: src/prefs.js:219
msgid ""
"External monitors are controlled over DDC/CI. Your user needs access to /dev/"
"i2c-* (usually the “i2c” group)."
msgstr ""
"Los monitores externos se controlan por DDC/CI. Tu usuario necesita acceso "
"a /dev/i2c-* (normalmente el grupo «i2c»)."

#: src/prefs.js:223
msgid "ddcutil found"
msgstr "ddcutil encontrado"

#: src/prefs.js:223
msgid "ddcutil not found"
msgstr "ddcutil no encontrado"

#: src/prefs.js:224
msgid "Install ddcutil from your distribution, then press Scan again"
msgstr "Instala ddcutil desde tu distribución y pulsa «Buscar de nuevo»"

#: src/prefs.js:226
msgid "Scan again"
msgstr "Buscar de nuevo"

#: src/prefs.js:231
msgid "ddcutil program"
msgstr "Programa ddcutil"

#: src/prefs.js:234
msgid "Extra arguments"
msgstr "Argumentos adicionales"

#: src/prefs.js:237
msgid "Pause between writes"
msgstr "Pausa entre escrituras"

#: src/prefs.js:238
msgid "Milliseconds. Raise it if a monitor misses changes"
msgstr "Milisegundos. Auméntala si un monitor pierde cambios"

#: src/prefs.js:242
msgid "Debug messages"
msgstr "Mensajes de depuración"

#: src/prefs.js:242
msgid "Written to the system journal"
msgstr "Se escriben en el registro del sistema"

#: src/lib/displays.js:37
msgid "Monitor"
msgstr "Monitor"

#: src/lib/displays.js:287
msgid "Built-in Display"
msgstr "Pantalla integrada"

#: src/lib/displays.js:288
msgid "Built-in"
msgstr "Integrada"

