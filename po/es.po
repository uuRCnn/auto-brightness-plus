#, javascript-format
msgid "Monitor %d"
msgstr "Monitor %d"

#: src/lib/notify.js:115
msgid "Claude is waiting for you"
msgstr "Claude te está esperando"

#: src/lib/notify.js:115
msgid "Claude is done"
msgstr "Claude ha terminado"

#: src/lib/notify.js:129
msgid "Go to the terminal"
msgstr "Ir a la terminal"

