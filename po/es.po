msgstr "Antes"

#: src/lib/ui.js:122
msgid "Later"
msgstr "Después"

#: src/lib/ui.js:165
msgid "Evening dimming and more"
msgstr "Atenuación nocturna y más"

#: src/lib/ui.js:282
msgid "Extra dimming"
msgstr "Atenuación extra"

#: src/lib/ui.js:294
msgid "Turn off others"
msgstr "Apagar las demás"

#: src/lib/ui.js:318
msgid "Off"
msgstr "Desactivada"

#: src/lib/ui.js:335
msgid "Turned off"
msgstr "Apagada"

#: src/lib/ui.js:335
#, javascript-format
msgid "Brightness %s"
msgstr "Brillo %s"

#: src/lib/ui.js:344
#, javascript-format
msgid "Sunset %s %s %d min"
msgstr "Atardecer %s %s %d min"

#: src/lib/ui.js:347
msgid "Fixed time"
msgstr "Hora fija"

#: src/lib/ui.js:421
msgid "Temperature"
msgstr "Temperatura"

#: src/lib/ui.js:498
msgid "Sunset to sunrise"
msgstr "Del atardecer al amanecer"

#: src/lib/ui.js:514
msgid "Turns on together with Night Light"
msgstr "Se activa junto con la Luz nocturna"

#: src/lib/ui.js:516
msgid "Starts when Night Light starts"
msgstr "Empieza cuando empieza la Luz nocturna"
